/* 路线详情 route-detail 样式 · V1.2 统一视觉
 * 颜色全部引用 app.wxss 全局 Token（零 raw hex 泄漏）
 */

.route-detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
  padding-bottom: var(--space-2xl);
}

/* ══════ ① 顶部区域 ══════ */
.rd-header {
  padding: var(--space-md) var(--page-x) var(--space-lg);
}
.rd-kind {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
  font-size: var(--fs-mini);
  font-weight: 600;
  margin-bottom: var(--space-sm);
}
.rd-kind.basic { color: var(--text-sub); border: 2rpx solid var(--surface-3); background: var(--surface-2); }
.rd-kind.topic { color: var(--gold); border: 2rpx solid var(--gold-a20); background: var(--gold-a06); }

.rd-name {
  font-size: var(--fs-display);
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 12rpx;
}
.rd-tagline {
  font-size: var(--fs-body);
  color: var(--gold);
  font-weight: 400;   /* 500→400（全局字重统一，Step5） */
  margin-bottom: var(--space-sm);
  line-height: 1.4;
}
.rd-desc {
  font-size: var(--fs-caption);
  color: var(--text-sub);
  line-height: 1.7;
  margin-bottom: var(--space-lg);
}

/* 进度摘要 */
.rd-progress-summary {
  margin-bottom: var(--space-md);
}
.rd-progress-num {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}
.rd-watched {
  font-size: var(--fs-display-sm);
  font-weight: 700;   /* 800→700（全局字重统一，Step5） */
  color: var(--gold);
}
.rd-total {
  font-size: var(--fs-body);
  color: var(--text-weak);
  margin-left: 6rpx;
}
.rd-bar {
  height: 10rpx;
  background: var(--surface-3);
  border-radius: 6rpx;
  overflow: hidden;
}
.rd-bar-fill {
  height: 100%;
  background: var(--gold);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 当前观看节点横幅 */
.rd-current-banner {
  margin-top: var(--space-md);
  padding: 18rpx var(--space-md);
  background: var(--gold-a10);
  border: 2rpx solid var(--gold-a50);
  border-radius: var(--radius-md);
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--gold);
}

/* ══════ ② 下一部推荐 ══════ */
.rd-section-label {
  font-size: var(--fs-mini);
  color: var(--text-weak);
  margin: var(--space-md) var(--page-x) var(--space-sm);
}
.rd-next-card {
  margin: 0 var(--page-x) var(--space-xs);
  background: var(--surface-2);
  border: 2rpx solid var(--gold-a20);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  display: flex;
  align-items: center;
  gap: var(--space-md);
}
.rd-next-info { flex: 1; min-width: 0; }
.rd-next-name {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: var(--space-xs);
}
.rd-next-phase {
  font-size: var(--fs-caption);
  color: var(--text-sub);
}
.rd-next-btn {
  padding: var(--space-sm) 36rpx;
  background: var(--gold);
  color: var(--gold-btn-text);
  font-size: var(--fs-caption);
  font-weight: 700;
  border-radius: var(--space-xs);
  flex-shrink: 0;
}
.rd-next-done {
  margin: 0 var(--page-x) var(--space-xs);
  background: var(--surface-2);
  border: 2rpx solid var(--surface-3);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  font-size: var(--fs-body);
  color: var(--text-sub);
}
.rd-next-done .ico-check { color: var(--success); }

/* ══════ ③ 路线电影列表 ══════ */
.rd-list {
  padding: var(--space-xs) var(--page-x) 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}
.rd-node {
  background: var(--surface-2);
  border: 2rpx solid var(--surface-3);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}
.rd-node.is-current {
  background: linear-gradient(135deg, var(--gold-a06), var(--surface-2));
  border-color: var(--gold-a50);
}
.rd-no {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--surface-3);
  color: var(--text-weak);
  font-size: var(--fs-body);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.rd-no.current {
  background: var(--gold);
  color: var(--gold-btn-text);
}
.rd-node-main {
  flex: 1;
  min-width: 0;
}
.rd-node-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.3;
}
.rd-node.is-current .rd-node-title {
  color: var(--gold);
}
.rd-node-en {
  font-size: var(--fs-mini);
  color: var(--text-weak);
  margin: 4rpx 0 10rpx;
  line-height: 1.3;
}
.rd-node-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.rd-phase-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.rd-phase-text {
  font-size: var(--fs-mini);
  color: var(--text-sub);
}
.rd-type {
  font-size: var(--fs-mini);
  color: var(--text-weak);
}

/* 状态色块 */
.rd-status {
  flex-shrink: 0;
  padding: var(--space-xs) 18rpx;
  border-radius: var(--radius-full);
  font-size: var(--fs-mini);
  font-weight: 600;
}
.rd-status.unwatched {
  background: var(--gold-a10);
  color: var(--gold);
  border: 2rpx solid var(--gold-a20);
}
.rd-status.watching {
  background: var(--success-a10);
  color: var(--success);
  border: 2rpx solid var(--success-a20);
}
.rd-status.watched {
  background: var(--surface-3);
  color: var(--text-weak);
  border: 2rpx solid var(--surface-3);
}

/* ══════ 未找到 ══════ */
.rd-empty {
  padding: 160rpx var(--page-x);
  text-align: center;
}
.rd-empty-title {
  font-size: var(--fs-title);
  color: var(--text-main);
  margin-bottom: 12rpx;
}
.rd-empty-sub {
  font-size: var(--fs-caption);
  color: var(--text-weak);
}

/* ══════ CSS 图标 ══════ */
.ico-check {
  width: 16rpx;
  height: 18rpx;
  position: relative;
  display: inline-block;
}
.ico-check::after {
  content: '';
  position: absolute;
  left: 1rpx;
  top: 1rpx;
  width: 7rpx;
  height: 13rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg);
}
