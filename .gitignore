# WorkBuddy 项目数据与个人上下文（工具管理目录，不纳入版本库）
.workbuddy/

# 依赖
node_modules/

# 系统与编辑器
.DS_Store
Thumbs.db
*.log

# 小程序渲染产物（原型预览图，可重新生成）
wechat/assets/preview/_*.png
wechat/assets/preview/_*.svg
wechat/assets/icons/tab/_*.png
wechat/assets/icons/tab/_*.svg
douyin/assets/preview/_*.png
douyin/assets/preview/_*.svg

# 非源码目录（文档归档 / 备份 / 上传产物 / 恢复资料 / AI协作同步文件）
# 仅本地保留，不进版本库
AI生成文件/
恢复资料/
backup/
wechat-v1.2.0-upload/
给*AI同步文件.txt

# OCR 瞬时输出（可重新生成，不进版本库）
workspace/ocr_result*.txt

# 部署打包产物（可由 h5/ 重新打包，不进版本库，避免仓库膨胀）
*.tar.gz

# 私钥等凭据（严禁入库；仓库 huogou/MCU 为公开仓库）
*.pem
*.key
*.p12
id_rsa*
id_ed25519*
