<!-- 宇宙全景图 panorama（V1.2 纵向 Phase 时间轴） - V3 真机适配专项 -->
<view class="mcu-page pano-page">
  <view class="page-head">
    <view class="page-title">宇宙全景图</view>
    <view class="page-sub">按阶段浏览 · 金色 ✓ 为已看 · 点击卡片进入详情</view>
  </view>

  <scroll-view class="pano-timeline" scroll-y>
    <block wx:for="{{phaseGroups}}" wx:key="phase">
      <view class="phase-group">
        <view class="phase-header" style="border-left-color:{{item.color}};">
          <view class="phase-number" style="background:{{item.color}};">{{item.phase}}</view>
          <view class="phase-meta">
            <view class="phase-name">{{item.title}}</view>
            <view class="phase-years">{{item.years}}</view>
          </view>
          <view class="phase-count">{{item.watched}}/{{item.count}} 已看</view>
        </view>

        <view class="movie-list">
          <view wx:for="{{item.movies}}" wx:for-item="movie" wx:key="id"
                class="movie-card {{movie.seen?'is-seen':''}}"
                data-id="{{movie.id}}" bindtap="goMovie">
            <view class="poster-wrap">
              <image wx:if="{{movie.poster && !_posterErr[movie.id]}}" class="poster-img" src="{{movie.poster}}" mode="aspectFill" lazy-load binderror="onPosterError" data-id="{{movie.id}}"></image>
              <view wx:else class="poster-fallback" style="background:{{movie.phaseColor}};">{{movie.firstChar}}</view>
              <view wx:if="{{movie.seen}}" class="seen-badge">✓</view>
            </view>
            <view class="movie-info">
              <view class="movie-cn">{{movie.cn}}</view>
              <view class="movie-en">{{movie.en}}</view>
              <view class="movie-tags">
                <text class="movie-year">{{movie.year}}</text>
                <text class="phase-tag-pill" style="color:{{movie.phaseColor}};border-color:{{movie.phaseColor}};">Phase {{movie.phase}}</text>
                <text wx:if="{{movie.mainline}}" class="tag-mainline">主线</text>
                <text wx:if="{{movie.starter}}" class="tag-starter">入门</text>
              </view>
            </view>
            <view class="movie-arrow">›</view>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{upcoming.length}}" class="upcoming-section">
      <view class="upcoming-title">即将上映</view>
      <view class="movie-list">
        <view wx:for="{{upcoming}}" wx:for-item="movie" wx:key="id"
              class="movie-card is-upcoming"
              data-id="{{movie.id}}" bindtap="goMovie">
          <view class="poster-wrap">
            <image wx:if="{{movie.poster && !_posterErr[movie.id]}}" class="poster-img" src="{{movie.poster}}" mode="aspectFill" lazy-load binderror="onPosterError" data-id="{{movie.id}}"></image>
            <view wx:else class="poster-fallback" style="background:{{movie.phaseColor}};">{{movie.firstChar}}</view>
          </view>
          <view class="movie-info">
            <view class="movie-cn">{{movie.cn}}</view>
            <view class="movie-tags">
              <text class="movie-year">{{movie.year}}</text>
              <text class="phase-tag-pill" style="color:{{movie.phaseColor}};border-color:{{movie.phaseColor}};">Phase {{movie.phase}}</text>
            </view>
          </view>
          <view class="movie-arrow">›</view>
        </view>
      </view>
    </view>

    <view class="pano-foot">共 {{phaseGroups.length}} 个阶段 · 沿时间向下浏览完整宇宙</view>
  </scroll-view>
</view>
