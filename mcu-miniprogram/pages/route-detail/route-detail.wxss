/* ============================================================
 * 路线详情 route-detail 样式 · D12-A Step3-7-A
 * 依据：D10-A 冻结稿 Token 体系 + routes 页 / movie 页视觉语言
 * 换算：原型 px × 2 = rpx；颜色全部引用 app.wxss 全局 Token（零 raw hex 泄漏）
 * 状态色与 movie 页一致：未观看=金 / 正在观看=绿(success) / 已观看=灰
 * ============================================================ */

.route-detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
  padding-bottom: 48rpx;
}

/* ══════ ① 顶部区域 ══════ */
.rd-header {
  padding: 28rpx 40rpx 32rpx;
}
.rd-kind {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  margin-bottom: 20rpx;
}
.rd-kind.basic { color: var(--text-sub); border: 2rpx solid var(--surface-3); background: var(--surface-2); }
.rd-kind.topic { color: var(--gold); border: 2rpx solid var(--gold-a20); background: var(--gold-a06); }

.rd-name {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: -0.01em;
  margin-bottom: 12rpx;
}
.rd-tagline {
  font-size: 26rpx;
  color: var(--gold);
  font-weight: 500;
  margin-bottom: 20rpx;
  line-height: 1.4;
}
.rd-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.7;
  margin-bottom: 32rpx;
}

/* 进度摘要 */
.rd-progress-summary {
  margin-bottom: 24rpx;
}
.rd-progress-num {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}
.rd-watched {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--gold);
  letter-spacing: -0.01em;
}
.rd-total {
  font-size: 26rpx;
  color: var(--text-weak);
  margin-left: 6rpx;
}
.rd-bar {
  height: 10rpx;
  background: var(--surface-3);
  border-radius: 6rpx;
  overflow: hidden;
}
.rd-bar-fill {
  height: 100%;
  background: var(--gold);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 当前观看节点横幅（仅当前路线） */
.rd-current-banner {
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  background: var(--gold-a10);
  border: 2rpx solid var(--gold-a50);
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 0.02em;
}

/* ══════ ② 下一部推荐 ══════ */
.rd-section-label {
  font-size: 22rpx;
  color: var(--text-weak);
  margin: 28rpx 40rpx 16rpx;
  letter-spacing: 0.02em;
}
.rd-next-card {
  margin: 0 40rpx 8rpx;
  background: var(--surface-2);
  border: 2rpx solid var(--gold-a20);
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.rd-next-info { flex: 1; min-width: 0; }
.rd-next-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 8rpx;
}
.rd-next-phase {
  font-size: 24rpx;
  color: var(--text-sub);
}
.rd-next-btn {
  padding: 16rpx 36rpx;
  background: var(--gold);
  color: var(--bg);
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 8rpx;
  flex-shrink: 0;
  letter-spacing: 0.02em;
}
.rd-next-done {
  margin: 0 40rpx 8rpx;
  background: var(--surface-2);
  border: 2rpx solid var(--surface-3);
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}
.rd-next-done .ico-check { color: var(--success); }

/* ══════ ③ 路线电影列表 ══════ */
.rd-list {
  padding: 8rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.rd-node {
  background: var(--surface-2);
  border: 2rpx solid var(--surface-3);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
/* 当前观看节点金色高亮 */
.rd-node.is-current {
  background: linear-gradient(135deg, var(--gold-a06), var(--surface-2));
  border-color: var(--gold-a50);
}
.rd-no {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--surface-3);
  color: var(--text-weak);
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.rd-no.current {
  background: var(--gold);
  color: var(--bg);
}
.rd-node-main {
  flex: 1;
  min-width: 0;
}
.rd-node-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.3;
}
.rd-node.is-current .rd-node-title {
  color: var(--gold);
}
.rd-node-en {
  font-size: 22rpx;
  color: var(--text-weak);
  margin: 4rpx 0 10rpx;
  line-height: 1.3;
}
.rd-node-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.rd-phase-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.rd-phase-text {
  font-size: 22rpx;
  color: var(--text-sub);
}
.rd-type {
  font-size: 22rpx;
  color: var(--text-weak);
}

/* 状态色块（与 movie 页一致） */
.rd-status {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
}
.rd-status.unwatched {
  background: var(--gold-a10);
  color: var(--gold);
  border: 2rpx solid var(--gold-a20);
}
.rd-status.watching {
  background: var(--success-a10);
  color: var(--success);
  border: 2rpx solid var(--success-a20);
}
.rd-status.watched {
  background: var(--surface-3);
  color: var(--text-weak);
  border: 2rpx solid var(--surface-3);
}

/* ══════ 未找到 ══════ */
.rd-empty {
  padding: 160rpx 40rpx;
  text-align: center;
}
.rd-empty-title {
  font-size: 32rpx;
  color: var(--text-main);
  margin-bottom: 12rpx;
}
.rd-empty-sub {
  font-size: 24rpx;
  color: var(--text-weak);
}

/* ══════ CSS 图标（无 emoji / 无图片资源） ══════ */
.ico-check {
  width: 16rpx;
  height: 18rpx;
  position: relative;
  display: inline-block;
}
.ico-check::after {
  content: '';
  position: absolute;
  left: 1rpx;
  top: 1rpx;
  width: 7rpx;
  height: 13rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg);
}
