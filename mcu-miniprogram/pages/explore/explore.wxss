/* explore 关系探索（Tab3）· V1.1 Step6：入口聚合页，全 Token 化 */
.mcu-page { min-height: 100vh; background: var(--bg); padding: 0 32rpx; box-sizing: border-box; }

.page-head { padding: 40rpx 0 24rpx; }
.page-title { font-size: 44rpx; font-weight: 700; color: var(--text-main); }
.page-sub { font-size: 24rpx; color: var(--text-sub); margin-top: 8rpx; }

.entry-card { display: flex; align-items: center; background: var(--surface-2); border: 1rpx solid var(--surface-3); border-radius: 20rpx; padding: 28rpx 32rpx; margin-bottom: 24rpx; }
.entry-card-hover { background: var(--surface-3); }
.entry-icon { width: 72rpx; height: 72rpx; border-radius: 18rpx; background: var(--gold-a15); color: var(--gold); font-size: 40rpx; display: flex; align-items: center; justify-content: center; margin-right: 24rpx; }
/* 角色图鉴入口：紫色系图标底色，与全景图金色入口区分 */
.icon-char { background: var(--p4-a15); color: var(--p4); }
.entry-body { flex: 1; min-width: 0; }
.entry-name { font-size: 30rpx; font-weight: 600; color: var(--text-main); }
.entry-desc { font-size: 22rpx; color: var(--text-sub); margin-top: 6rpx; }
.entry-arrow { font-size: 48rpx; color: var(--text-weak); line-height: 1; }

.section-label { font-size: 26rpx; font-weight: 600; color: var(--gold); margin: 24rpx 0 20rpx; letter-spacing: 1rpx; }

.char-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.char-card { width: calc((100% - 40rpx) / 3); background: var(--surface-2); border: 1rpx solid var(--surface-3); border-radius: 18rpx; padding: 20rpx; box-sizing: border-box; }
.char-card-hover { border-color: var(--gold); background: var(--surface-3); }
.char-camp { display: inline-block; font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 20rpx; margin-bottom: 12rpx; }
.char-cn { font-size: 26rpx; font-weight: 600; color: var(--text-main); line-height: 1.3; }
.char-en { font-size: 20rpx; color: var(--text-sub); margin-top: 6rpx; }
.char-first { font-size: 19rpx; color: var(--text-weak); margin-top: 10rpx; }

.bottom-pad { height: 60rpx; }
