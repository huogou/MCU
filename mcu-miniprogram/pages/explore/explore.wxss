/* explore 关系探索（Tab3）· V1.2 统一视觉 */

.page-head { padding: var(--space-xl) 0 var(--space-md); }
.page-title { font-size: var(--fs-display); font-weight: 700; color: var(--text-main); }
.page-sub { font-size: var(--fs-caption); color: var(--text-sub); margin-top: var(--space-xs); }

.entry-card { display: flex; align-items: center; background: var(--surface-2); border: 1rpx solid var(--surface-3); border-radius: var(--radius-md); padding: var(--space-md) var(--space-lg); margin-bottom: var(--space-md); }
.entry-card-hover { background: var(--surface-3); }
.entry-icon { width: var(--space-2xl); height: var(--space-2xl); border-radius: 18rpx; background: var(--gold-a15); color: var(--gold); font-size: var(--fs-display-sm); display: flex; align-items: center; justify-content: center; margin-right: var(--space-md); flex-shrink: 0; }
/* 角色图鉴入口：紫色系图标底色，与全景图金色入口区分 */
.icon-char { background: var(--p4-a15); color: var(--p4); }
.entry-body { flex: 1; min-width: 0; }
.entry-name { font-size: var(--fs-title); font-weight: 600; color: var(--text-main); }
.entry-desc { font-size: var(--fs-caption); color: var(--text-sub); margin-top: 6rpx; }
.entry-arrow { font-size: var(--fs-display-sm); color: var(--text-weak); line-height: 1; }

.section-label { font-size: var(--fs-body); font-weight: 600; color: var(--gold); margin: var(--space-md) 0 var(--space-sm); letter-spacing: 1rpx; }

.char-grid { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
.char-card { width: calc((100% - 40rpx) / 3); background: var(--surface-2); border: 1rpx solid var(--surface-3); border-radius: var(--radius-md); padding: var(--space-sm); box-sizing: border-box; }
.char-card-hover { border-color: var(--gold); background: var(--surface-3); }
.char-camp { display: inline-block; font-size: var(--fs-mini); padding: 4rpx 14rpx; border-radius: var(--radius-lg); margin-bottom: 12rpx; }
.char-cn { font-size: var(--fs-body); font-weight: 600; color: var(--text-main); line-height: 1.3; }
.char-en { font-size: var(--fs-mini); color: var(--text-sub); margin-top: 6rpx; }
.char-first { font-size: var(--fs-mini); color: var(--text-weak); margin-top: 10rpx; }

.bottom-pad { height: 60rpx; }
