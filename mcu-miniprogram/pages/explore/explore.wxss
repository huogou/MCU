/* ============================================================
 * explore 关系探索（Tab3）· V1.2 视觉系统落地（按 VDS V2 §5）
 * 结构：头部 → 筛选 Chips → Canvas 网络图 → 关系列表
 * 颜色一律 var()（关系类型色 .rel-* 功能色类，Token 引用，零裸 hex）
 * 字号 5 档 / 圆角 Token / 间距 --space-*
 * 阵营色 / 海报阶段色系统统一在 app.wxss 全局
 * ============================================================ */

.explore-page {
  padding: 0 var(--page-x);
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: var(--space-2xl);
}

/* —— 页面头部（VDS §5.2） —— */
.page-head {
  padding: var(--space-xl) 0 var(--space-md);
}
.page-title {
  font-size: var(--fs-display);          /* 56rpx */
  font-weight: 700;
  color: var(--text-main);
}
.page-sub {
  font-size: var(--fs-caption);          /* 24rpx */
  font-weight: 400;
  color: var(--text-sub);
  margin-top: var(--space-xs);
}

/* —— 筛选 Chips（VDS §5.5） —— */
.filter-row {
  width: 100%;
  white-space: nowrap;
  margin-bottom: var(--space-md);
}
.filter-inner {
  display: inline-flex;
  gap: var(--space-xs);
  padding: 4rpx 0;
}
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 var(--space-md);
  border-radius: var(--radius-full);
  font-size: var(--fs-caption);          /* 24rpx */
  font-weight: 600;
  color: var(--text-sub);
  background: var(--surface-2);
  border: 1rpx solid var(--surface-3);
  box-sizing: border-box;
  flex-shrink: 0;
}
.chip-active {
  color: var(--gold);
  background: var(--gold-a10);
  border-color: var(--gold);
}
.chip-hover { opacity: 0.85; }

/* —— Canvas 关系网络图（VDS §5.3） —— */
.canvas-wrap {
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1rpx solid var(--surface-3);
  background: var(--bg);
  margin-bottom: var(--space-xl);
}
.relation-canvas {
  width: 750rpx;
  height: 600rpx;
  display: block;
}

/* —— 关系列表（VDS §5.6 卡片式） —— */
.section-label {
  font-size: var(--fs-body);             /* 28rpx */
  font-weight: 600;
  color: var(--gold);
  margin-bottom: var(--space-sm);
  letter-spacing: 1rpx;
}
.relation-list {
  display: flex;
  flex-direction: column;
}
.relation-card {
  background: var(--surface-2);
  border: 1rpx solid var(--surface-3);
  border-radius: var(--radius-lg);       /* 20rpx */
  padding: var(--space-md);              /* 28rpx */
  margin-bottom: var(--space-sm);
}
.rel-card-hover { border-color: var(--gold); }
.rel-main {
  display: flex;
  align-items: center;
  justify-content: center;
}
.rel-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid transparent;        /* 阵营色由 fring-* 覆盖 */
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-3);
}
.rel-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-title);            /* 36rpx 首字 */
  font-weight: 600;
  color: var(--white-a70);
}
.rel-line {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-sm);
  position: relative;
}
.rel-line::before {
  content: '';
  position: absolute;
  left: var(--space-sm); right: var(--space-sm);
  height: 1rpx;
  background: var(--surface-3);
}
.rel-type {
  position: relative;
  font-size: var(--fs-mini);             /* 22rpx */
  font-weight: 600;
  padding: 0 var(--space-xs);
  background: var(--surface-2);
  white-space: nowrap;
}
/* 关系类型功能色（VDS §5.3，Token 引用） */
.rel-ally   { color: var(--accent-blue); }
.rel-enemy  { color: var(--accent-red); }
.rel-mentor { color: var(--gold); }
.rel-family { color: var(--accent-purple); }
.rel-rival  { color: var(--accent-red); }

.rel-info {
  text-align: center;
  margin-top: var(--space-sm);
  padding-top: var(--space-xs);
  border-top: 1rpx solid var(--surface-3);
}
.rel-name {
  font-size: var(--fs-body);             /* 28rpx */
  font-weight: 600;
  color: var(--text-main);
}
.rel-name-arrow {
  color: var(--text-weak);
  font-weight: 400;
  margin: 0 var(--space-xs);
}
.rel-shared {
  font-size: var(--fs-mini);             /* 22rpx */
  font-weight: 400;
  color: var(--text-weak);
  margin-top: var(--space-xs);
}

.bottom-pad { height: 60rpx; }
