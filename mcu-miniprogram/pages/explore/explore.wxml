<!-- 关系探索 explore（Tab3）· V1.2 视觉系统落地（按 VDS V2 §5）
     结构：页面头部 → 筛选 Chips → Canvas 关系网络图 → 关系列表
     交互：点击 Canvas 节点切换中心角色；Chips 单选过滤 -->
<view class="mcu-page explore-page">

  <!-- 页面头部（VDS §5.2：56rpx/700 标题 + 副标题） -->
  <view class="page-head">
    <view class="page-title">关系探索</view>
    <view class="page-sub">以 {{centerName || '角色'}} 为中心 · 点击节点切换探索</view>
  </view>

  <!-- 关系类型筛选 Chips（VDS §5.5，5 种单选） -->
  <scroll-view scroll-x class="filter-row" enable-flex>
    <view class="filter-inner">
      <view wx:for="{{filters}}" wx:key="key"
            class="chip {{activeFilter == item.key ? 'chip-active' : ''}}"
            data-key="{{item.key}}" bindtap="onFilter" hover-class="chip-hover" hover-stay-time="60">
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <!-- Canvas 关系网络图（VDS §5.3） -->
  <view class="canvas-wrap">
    <canvas type="2d" id="relCanvas" class="relation-canvas" bindtap="onCanvasTap"></canvas>
  </view>

  <!-- 关系列表（VDS §5.6 卡片式，随筛选联动） -->
  <view class="section-label">关系（{{relations.length}}）</view>
  <view class="relation-list">
    <view wx:for="{{relations}}" wx:key="id" class="relation-card"
          data-id="{{item.id}}" bindtap="goCharacter" hover-class="rel-card-hover" hover-stay-time="80">
      <view class="rel-main">
        <view class="rel-avatar fring-{{centerCls}}">
          <image wx:if="{{centerAvatar}}" class="fill-img" src="{{centerAvatar}}" mode="aspectFill" lazy-load="true"/>
          <view wx:else class="rel-fallback fbg-{{centerCls}}">{{centerFirst}}</view>
        </view>
        <view class="rel-line">
          <view class="rel-type rel-{{item.type}}">{{item.typeLabel}}</view>
        </view>
        <view class="rel-avatar fring-{{item.campCls}}">
          <image wx:if="{{item.avatar && !_imgErr[item.id]}}" class="fill-img" src="{{item.avatar}}" mode="aspectFill" lazy-load="true" binderror="onImgError" data-id="{{item.id}}" />
          <view wx:else class="rel-fallback fbg-{{item.campCls}}">{{item.first}}</view>
        </view>
      </view>
      <view class="rel-info">
        <view class="rel-name">{{centerName}} <text class="rel-name-arrow">↔</text> {{item.name}}</view>
        <view class="rel-shared">{{item.typeLabel}} · 共同出演 {{item.shared}} 部</view>
      </view>
    </view>
  </view>

  <view class="bottom-pad"></view>
</view>
