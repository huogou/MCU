/* ============================================================
 * 我的MCU 样式 · D12-A Step3-7-B
 * 依据：D10 Token 体系（深色背景 / 金色强调 / 卡片结构 / 进度展示）
 * 换算：原型 px × 2 = rpx；颜色全部引用 app.wxss 全局 Token（零 raw hex 泄漏）
 * Token 映射：--bg / --surface-2 / --surface-3 / --text-main / --text-sub
 *           / --text-weak / --gold / --success / --p1..p6（阶段色）
 *           --gold-a20→var(--gold-a20) / --gold-a50→var(--gold-a50)
 * ============================================================ */

.mcu-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* 海报阶段色兜底（与 movie 页一致：135deg 阶段色 → 60% 阶段色） */
.poster-p1 { background: linear-gradient(135deg, var(--p1), var(--p1-a60)); }
.poster-p2 { background: linear-gradient(135deg, var(--p2), var(--p2-a60)); }
.poster-p3 { background: linear-gradient(135deg, var(--p3), var(--p3-a60)); }
.poster-p4 { background: linear-gradient(135deg, var(--p4), var(--p4-a60)); }
.poster-p5 { background: linear-gradient(135deg, var(--p5), var(--p5-a60)); }
.poster-p6 { background: linear-gradient(135deg, var(--p6), var(--p6-a60)); }

/* ══════ ① 顶部用户状态区 ══════ */
.mcu-hero {
  padding: 40rpx 40rpx 36rpx;
  background: linear-gradient(160deg, var(--gold-a10), transparent 60%);
  border-bottom: 2rpx solid var(--surface-3);
}
.mcu-hero-label {
  font-size: 24rpx;
  color: var(--text-weak);
  letter-spacing: 0.06em;
  margin-bottom: 16rpx;
}
.mcu-explore {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.mcu-explore-num {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--gold);
  line-height: 1;
  letter-spacing: -0.02em;
}
.mcu-explore-sep,
.mcu-explore-total {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-sub);
}
.mcu-explore-tip {
  font-size: 24rpx;
  color: var(--text-weak);
  margin-top: 8rpx;
}
.mcu-progress {
  height: 12rpx;
  background: var(--surface-3);
  border-radius: 6rpx;
  overflow: hidden;
  margin: 24rpx 0 12rpx;
}
.mcu-progress-bar {
  height: 100%;
  background: var(--gold);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}
.mcu-progress-tip {
  font-size: 22rpx;
  color: var(--text-weak);
}

/* ══════ 区块标签 ══════ */
.section-label {
  font-size: 22rpx;
  color: var(--text-weak);
  margin: 32rpx 40rpx 16rpx;
  letter-spacing: 0.02em;
}

/* ══════ ② 当前路线卡 ══════ */
.route-next-card {
  margin: 0 40rpx 8rpx;
  background: var(--surface-2);
  border: 2rpx solid var(--gold-a20);
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.route-next-info {
  flex: 1;
  min-width: 0;
}
.rn-label {
  font-size: 22rpx;
  color: var(--gold);
  font-weight: 600;
  margin-bottom: 8rpx;
  letter-spacing: 0.04em;
}
.rn-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 6rpx;
}
.rn-sub {
  font-size: 24rpx;
  color: var(--text-sub);
}
.route-next-btn {
  padding: 16rpx 32rpx;
  background: var(--gold);
  color: var(--bg);
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  border-radius: 8rpx;
  flex-shrink: 0;
  letter-spacing: 0.02em;
}
.route-next-btn.is-disabled {
  background: var(--surface-3);
  color: var(--text-weak);
}

/* ══════ ③ ④ 列表卡片 ══════ */
.card-list {
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.work-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--surface-2);
  border: 2rpx solid var(--surface-3);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.wc-poster {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--white);
  text-shadow: 0 2rpx 6rpx var(--black-a35);
  border: 2rpx solid var(--white-a12);
}
.wc-info {
  flex: 1;
  min-width: 0;
}
.wc-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 4rpx;
}
.wc-sub {
  font-size: 22rpx;
  color: var(--text-weak);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.wc-badge {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
.wc-badge.done {
  color: var(--text-weak);
  background: var(--surface-3);
}
.wc-badge.fav {
  color: var(--gold);
  background: var(--gold-a12);
  border: 2rpx solid var(--gold-a30);
}

/* ══════ ② 后续入口预留（V1.1 Step3：分享 / 成就，只展示入口） ══════ */
.entry-row {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 40rpx 0;
}
.entry-card {
  flex: 1;
  background: var(--surface-2);
  border: 2rpx solid var(--surface-3);
  border-radius: 20rpx;
  padding: 24rpx;
  position: relative;
  overflow: hidden;
}
.entry-card.entry-primary {
  background: linear-gradient(135deg, var(--gold-a10), var(--gold-a02));
  border-color: var(--gold-a30);
}
.entry-hover { opacity: 0.88; }
.entry-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 6rpx;
}
.entry-card.entry-primary .entry-title { color: var(--gold); }
.entry-desc {
  font-size: 22rpx;
  color: var(--text-weak);
}
.entry-badge {
  position: absolute;
  top: 0;
  right: 0;
  padding: 6rpx 14rpx;
  font-size: 20rpx;
  color: var(--bg);
  background: var(--gold);
  border-radius: 0 20rpx 0 14rpx;
  font-weight: 600;
}

/* ══════ ②.5 我的成就墙（V1.1 Step5：横滑徽章，已获得金 / 未获得灰） ══════ */
.ach-row {
  display: flex;
  gap: 20rpx;
  padding: 0 40rpx;
  white-space: nowrap;
}
.ach-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 132rpx;
}
.ach-hover { opacity: 0.85; }
.ach-badge {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  background: var(--surface-3);
  border: 2rpx solid var(--surface-3);
  color: var(--text-weak);
  margin-bottom: 10rpx;
}
.ach-badge.gained {
  background: var(--gold-a14);
  border-color: var(--gold-a50);
  color: var(--gold);
}
.ach-name {
  font-size: 22rpx;
  color: var(--text-weak);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 132rpx;
}
.ach-name.gained {
  color: var(--text-main);
}

/* ══════ ③ 当前路线卡（增强：路线进度条） ══════ */
.rn-progress {
  height: 8rpx;
  background: var(--surface-3);
  border-radius: 4rpx;
  overflow: hidden;
  margin-top: 12rpx;
}
.rn-progress-bar {
  height: 100%;
  background: var(--gold);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* ══════ ④ 最近观看（V1.1 Step3：横滑 3 部，海报+名称+已看徽章） ══════ */
.recent-row {
  display: flex;
  gap: 20rpx;
  padding: 0 40rpx;
  white-space: nowrap;
}
.recent-item {
  display: inline-flex;
  flex-direction: column;
  flex-shrink: 0;
  width: 168rpx;
}
.recent-hover { opacity: 0.85; }
.recent-poster {
  width: 168rpx;
  height: 236rpx;
  border-radius: 16rpx;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}
.recent-letter {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--white-a70);
}
.recent-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 6rpx 0;
  font-size: 20rpx;
  text-align: center;
  color: var(--text-weak);
  background: var(--bg-a55);
}
.recent-name {
  font-size: 24rpx;
  color: var(--text-sub);
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ══════ 空态 ══════ */
.empty-tip {
  font-size: 24rpx;
  color: var(--text-weak);
  line-height: 1.6;
  padding: 24rpx 8rpx;
}
.mcu-bottom-space {
  height: 40rpx;
}

/* ══════ ⑤ 反馈入口（Step3-8） ══════ */
.fb-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 40rpx 16rpx;
  padding: 28rpx 24rpx;
  background: var(--surface-2);
  border: 2rpx solid var(--surface-3);
  border-radius: 20rpx;
}
.fb-entry-info { flex: 1; min-width: 0; }
.fb-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}
.fb-entry-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.5;
}
.fb-entry-arrow {
  font-size: 40rpx;
  color: var(--text-weak);
  margin-left: 16rpx;
  flex-shrink: 0;
}
