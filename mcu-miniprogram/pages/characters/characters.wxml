<!-- 角色图鉴 characters（角色列表）· V1.1 Step6 -->
<view class="mcu-page">
  <view class="page-head">
    <view class="page-title">角色图鉴</view>
    <view class="page-sub">{{totalChars}} 位角色 · {{totalCamps}} 大阵营 · 从角色读懂宇宙关系</view>
  </view>

  <!-- 阵营筛选 -->
  <scroll-view scroll-x class="camp-scroll" enable-flex>
    <view class="camp-row">
      <view class="camp-chip {{activeCamp==='all'?'camp-chip-on':''}}"
            data-camp="all" bindtap="tapCamp">全部</view>
      <view wx:for="{{campChips}}" wx:key="key"
            class="camp-chip {{activeCamp===item.key?'camp-chip-on':''}}"
            data-camp="{{item.key}}" bindtap="tapCamp">
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view class="count-line">共 {{filteredCount}} 位角色</view>

  <!-- 角色卡片列表 -->
  <view class="char-list">
    <view wx:for="{{filtered}}" wx:key="id"
          class="char-card" data-id="{{item.id}}" bindtap="goCharacter" hover-class="char-card-hover">
      <!-- 真实头像（visuals.avatar，G-19 缺图首字徽章兜底） -->
      <view class="char-avatar fring-{{item.factionCls}} fbg-{{item.factionCls}} fc-{{item.factionCls}}">
        <image wx:if="{{item.avatarImg}}" class="fill-img" src="{{item.avatarImg}}" mode="aspectFill" />
        <text wx:else>{{item.avatar}}</text>
      </view>
      <view class="char-body">
        <view class="char-top">
          <view class="char-cn">{{item.cn}}</view>
          <view class="char-count"><text class="count-num">{{item.count}}</text> 部作品</view>
        </view>
        <view class="char-en">{{item.en}}</view>
        <view class="char-note">{{item.note}}</view>
        <view class="char-meta">
          <view class="char-camp pill-{{item.factionCls}}">{{item.factionLabel}}</view>
          <view class="char-first">首登场 · {{item.firstCn}}</view>
        </view>
      </view>
      <view class="char-arrow">›</view>
    </view>
  </view>

  <view class="bottom-pad"></view>
</view>
