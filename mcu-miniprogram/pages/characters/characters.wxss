/* 角色图鉴 characters（角色列表）· V1.1 Step6 · 深色宇宙科技风，全 Token 化 */
.mcu-page { min-height: 100vh; background: var(--bg); padding: 0 32rpx; box-sizing: border-box; }

.page-head { padding: 40rpx 0 24rpx; }
.page-title { font-size: 44rpx; font-weight: 700; color: var(--text-main); }
.page-sub { font-size: 24rpx; color: var(--text-sub); margin-top: 8rpx; }

/* 阵营筛选 chips（横向滚动） */
.camp-scroll { width: 100%; margin-bottom: 20rpx; white-space: nowrap; }
.camp-row { display: flex; gap: 16rpx; padding: 4rpx 0 8rpx; }
.camp-chip { flex-shrink: 0; font-size: 24rpx; color: var(--text-sub); background: var(--surface-2); border: 1rpx solid var(--surface-3); border-radius: 999rpx; padding: 12rpx 28rpx; }
.camp-chip-on { color: var(--gold); border-color: var(--gold); background: var(--gold-a10); font-weight: 600; }

.count-line { font-size: 22rpx; color: var(--text-weak); margin: 8rpx 0 20rpx; }

/* 角色卡片列表 */
.char-list { display: flex; flex-direction: column; gap: 20rpx; }
.char-card { display: flex; align-items: center; background: var(--surface-2); border: 1rpx solid var(--surface-3); border-radius: 20rpx; padding: 24rpx; }
.char-card-hover { border-color: var(--gold); background: var(--surface-3); }
.char-avatar { width: 88rpx; height: 88rpx; border-radius: 50%; border: 2rpx solid; font-size: 40rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; margin-right: 24rpx; flex-shrink: 0; }
.char-body { flex: 1; min-width: 0; }
.char-top { display: flex; align-items: center; justify-content: space-between; }
.char-cn { font-size: 30rpx; font-weight: 600; color: var(--text-main); line-height: 1.3; flex: 1; min-width: 0; }
.char-count { font-size: 20rpx; color: var(--text-weak); flex-shrink: 0; margin-left: 16rpx; }
.count-num { color: var(--gold); font-weight: 700; font-size: 26rpx; }
.char-en { font-size: 20rpx; color: var(--text-sub); margin-top: 4rpx; }
.char-note { font-size: 22rpx; color: var(--text-sub); margin-top: 12rpx; line-height: 1.5; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.char-meta { display: flex; align-items: center; margin-top: 14rpx; }
.char-camp { display: inline-block; font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 20rpx; }
.char-first { font-size: 20rpx; color: var(--text-weak); margin-left: 16rpx; }
.char-arrow { font-size: 44rpx; color: var(--text-weak); margin-left: 12rpx; flex-shrink: 0; }

.bottom-pad { height: 60rpx; }
