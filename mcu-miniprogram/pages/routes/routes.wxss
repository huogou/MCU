/* ============================================================
 * 路线 routes 样式 · D12-A Step3-6
 * 依据：D10-A 冻结稿 CSS（恢复资料/D10原型/D10-A_观影主线强化原型.html line 1168-1301）
 * 换算：原型 px × 2 = rpx；颜色全部引用 app.wxss 全局 Token（零 raw hex 泄漏）
 * Token 映射：--s2→surface-2 / --s3→surface-3 / --t1→text-main / --t2→text-sub
 *           --t3→text-weak / --bd→surface-3 / --gold→gold / --ok→success
 *           --gold-a20→var(--gold-a20) / --gold-a50→var(--gold-a50)
 *           --r-sm→8rpx / --r-md→16rpx / --r-lg→24rpx
 * ============================================================ */

.routes-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* ══════ 头部 ══════ */
.routes-header {
  padding: 28rpx 40rpx 0;
}
.rh-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 24rpx;
  letter-spacing: -0.01em;
}
.route-tabs {
  display: flex;
  border-bottom: 2rpx solid var(--surface-3);
}
.route-tab {
  padding: 16rpx 36rpx;
  font-size: 28rpx;
  color: var(--text-weak);
  border-bottom: 4rpx solid transparent;
  margin-bottom: -2rpx;
  letter-spacing: 0.01em;
  box-sizing: border-box;
}
.route-tab.active {
  color: var(--gold);
  border-bottom-color: var(--gold);
  font-weight: 600;
}

/* ══════ 当前路线进度 ══════ */
.section-label {
  font-size: 22rpx;
  color: var(--text-weak);
  margin: 28rpx 40rpx 16rpx;
  letter-spacing: 0.02em;
}
.route-next-card {
  margin: 0 40rpx 24rpx;
  background: var(--surface-2);
  border: 2rpx solid var(--gold-a20);
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.route-next-info {
  flex: 1;
  min-width: 0;
}
.rn-label {
  font-size: 22rpx;
  color: var(--gold);
  font-weight: 600;
  margin-bottom: 8rpx;
  letter-spacing: 0.04em;
}
.rn-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 4rpx;
}
.rn-sub {
  font-size: 24rpx;
  color: var(--text-sub);
}
.route-next-btn {
  padding: 16rpx 32rpx;
  background: var(--gold);
  color: var(--bg);
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  border-radius: 8rpx;
  flex-shrink: 0;
  letter-spacing: 0.02em;
}
.route-next-btn.is-disabled {
  background: var(--surface-3);
  color: var(--text-weak);
}

/* ══════ 路线列表 ══════ */
.route-list {
  padding: 24rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.route-card {
  background: var(--surface-2);
  border: 2rpx solid var(--surface-3);
  border-radius: 16rpx;
  padding: 28rpx;
}
.route-card.current-route {
  border-color: var(--gold-a50);
  background: linear-gradient(135deg, var(--gold-a04), var(--surface-2));
}
.rc-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.rc-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}
.rc-count {
  font-size: 22rpx;
  color: var(--text-weak);
}
.rc-tag {
  font-size: 24rpx;
  color: var(--gold);
  margin-bottom: 8rpx;
  font-weight: 500;
}
.rc-for {
  font-size: 22rpx;
  color: var(--text-weak);
  line-height: 1.4;
  margin-bottom: 20rpx;
}
.rc-progress {
  height: 8rpx;
  background: var(--surface-3);
  border-radius: 4rpx;
  overflow: hidden;
}
.rc-progress .bar {
  height: 100%;
  border-radius: 4rpx;
}
