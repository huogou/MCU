/* ============================================================
 * 分享海报 share（V1.1 Step4）· 样式
 * 深色宇宙风（与 V1.0 Token 一致）：bg / surface / gold / 文本三级
 * 全 Token 化（零 raw hex 泄漏）
 * ============================================================ */

.share-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
  padding: 24rpx 40rpx 60rpx;
}

/* 海报画布预览（显示比例 750:1100） */
.poster-stage {
  background: var(--surface-1);
  border: 2rpx solid var(--surface-3);
  border-radius: 24rpx;
  padding: 24rpx;
  overflow: hidden;
}
.poster-canvas {
  width: 100%;
  height: 1000rpx;
  border-radius: 16rpx;
  background: var(--bg);
}

.poster-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  text-align: center;
}

/* 操作区 */
.actions {
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
}
.action-btn {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
  height: 88rpx;
  padding: 0;
  border-radius: 44rpx;
  border: none;
  text-align: center;
}
.action-btn.primary {
  background: var(--gold);
  color: var(--bg);
}
.action-btn:not(.primary) {
  background: var(--surface-2);
  color: var(--text-main);
  border: 2rpx solid var(--surface-3);
}
.btn-hover { opacity: 0.85; }

.share-note {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--text-weak);
  text-align: center;
}
