/* 分享海报 share · V1.2 统一视觉 */

.share-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
  padding: var(--space-md) var(--page-x) var(--space-2xl);
}

/* 海报画布预览 */
.poster-stage {
  background: var(--surface-1);
  border: 2rpx solid var(--surface-3);
  border-radius: 24rpx;
  padding: var(--space-md);
  overflow: hidden;
}
.poster-canvas {
  width: 100%;
  height: 1000rpx;
  border-radius: 16rpx;
  background: var(--bg);
}

.poster-tip {
  margin-top: 20rpx;
  font-size: var(--fs-caption);
  color: var(--text-sub);
  text-align: center;
}

/* 操作区 */
.actions {
  margin-top: var(--space-lg);
  display: flex;
  gap: 20rpx;
}
.action-btn {
  flex: 1;
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 88rpx;
  height: 88rpx;
  padding: 0;
  border-radius: 44rpx;
  border: none;
  text-align: center;
}
.action-btn.primary {
  background: var(--gold);
  color: var(--gold-btn-text);
}
.action-btn:not(.primary) {
  background: var(--surface-2);
  color: var(--text-main);
  border: 2rpx solid var(--surface-3);
}
.btn-hover { opacity: 0.85; }

.share-note {
  margin-top: var(--space-md);
  font-size: var(--fs-mini);
  color: var(--text-weak);
  text-align: center;
}
