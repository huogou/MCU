/* 角色详情 character · V1.2 统一视觉（C-01~C-09）
 * 颜色全部引用 app.wxss Token（零裸 hex）；图标纯 CSS 绘制。
 * 阵营色严格按设计 §4.4（红=复仇者/街头 蓝=阿斯加德/神盾 紫=银护/变种人 金=瓦坎达 灰=反派）。
 */

/* —— Hero 区（VDS §4.2 增强：更大头像 + 阵营氛围光效 + 简介直展） —— */
.hero {
  padding: var(--space-xl) 0 var(--space-xl);
  display: flex; flex-direction: column; align-items: center; text-align: center;
  position: relative;
  overflow: hidden;
}
/* 阵营氛围背景（设计 §4.3，a10 轻氛围，无图时优雅降级） */
.hero-red    { background: linear-gradient(160deg, var(--accent-red-a10),    var(--surface-1) 65%); }
.hero-blue   { background: linear-gradient(160deg, var(--accent-blue-a10),   var(--surface-1) 65%); }
.hero-purple { background: linear-gradient(160deg, var(--accent-purple-a10), var(--surface-1) 65%); }
.hero-gold   { background: linear-gradient(160deg, var(--gold-a04),           var(--surface-1) 65%); }
.hero-gray   { background: var(--surface-1); }
/* 阵营氛围径向光效（VDS §4.2.1，各阵营 Token 直接引用） */
.hero::before {
  content: '';
  position: absolute;
  top: -100rpx; right: -100rpx;
  width: 400rpx; height: 400rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--surface-3) 0%, transparent 70%);
  pointer-events: none;
}
.hero-red::before    { background: radial-gradient(circle, var(--accent-red-a10),    transparent 70%); }
.hero-blue::before   { background: radial-gradient(circle, var(--accent-blue-a10),   transparent 70%); }
.hero-purple::before { background: radial-gradient(circle, var(--accent-purple-a10), transparent 70%); }
.hero-gold::before   { background: radial-gradient(circle, var(--gold-a04),          transparent 70%); }
.hero-gray::before   { background: radial-gradient(circle, var(--surface-3),         transparent 70%); }
.hero-avatar {
  width: 160rpx; height: 160rpx; border-radius: 50%;
  border: 6rpx solid transparent; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.hero-cn { font-size: var(--fs-display-sm); font-weight: 700; color: var(--text-main); margin-top: var(--space-lg); line-height: 1.3; }
.hero-en { font-size: var(--fs-caption); color: var(--text-sub); margin-top: var(--space-xs); }
.hero-meta { display: flex; align-items: center; gap: var(--space-sm); margin-top: var(--space-sm); }
.hero-camp { font-size: var(--fs-mini); font-weight: 600; padding: 6rpx var(--space-sm); border-radius: var(--radius-full); }
.hero-count { font-size: var(--fs-mini); color: var(--text-weak); }
/* 简介直接展示在 Hero 区（VDS §4.2.1） */
.hero-note {
  font-size: var(--fs-body);
  color: var(--text-sub);
  line-height: 1.7;
  margin-top: var(--space-md);
  text-align: left;
  max-width: 600rpx;
}

/* —— 通用卡片（C-06：r20） —— */
.card { background: var(--surface-2); border: 1rpx solid var(--surface-3); border-radius: var(--radius-lg); padding: var(--space-md); margin-bottom: var(--space-md); }
.card-title { font-size: var(--fs-body); font-weight: 600; color: var(--text-main); margin-bottom: var(--space-sm); letter-spacing: 1rpx; }

/* —— 首次出现 / 关联作品 行 —— */
.first-row, .film-row { display: flex; align-items: center; }
.row-hover { opacity: 0.7; }
.first-poster { width: 120rpx; height: 180rpx; border-radius: var(--radius-sm); overflow: hidden; margin-right: var(--space-sm); flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--surface-3); }
.film-poster { width: 80rpx; height: 120rpx; border-radius: var(--radius-sm); overflow: hidden; margin-right: var(--space-sm); flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--surface-3); }
.poster-fallback { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-weight: 700; color: var(--white-a60); }
.first-poster .poster-fallback { font-size: var(--fs-display-sm); }
.film-poster .poster-fallback { font-size: var(--fs-body); }
.fill-img { width: 100%; height: 100%; display: block; }
.film-info { flex: 1; min-width: 0; }
.film-cn { font-size: var(--fs-body); color: var(--text-main); font-weight: 600; }
.film-en { font-size: var(--fs-mini); color: var(--text-sub); margin-top: 4rpx; }
.phase-tag { font-size: var(--fs-mini); color: var(--text-weak); border: 1rpx solid var(--surface-3); border-radius: var(--radius-sm); padding: var(--space-xs) 14rpx; flex-shrink: 0; }
.film-status { font-size: var(--fs-mini); padding: 6rpx 16rpx; border-radius: var(--radius-lg); flex-shrink: 0; }
.status-unwatched { color: var(--gold); background: var(--gold-a15); }
.status-watching { color: var(--success); background: var(--success-a15); }
.status-watched { color: var(--text-weak); background: var(--surface-3); }

/* —— 关联作品列表 —— */
.film-list { display: flex; flex-direction: column; gap: var(--space-sm); }

/* —— 关系探索：关联角色网格 —— */
.related-grid { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
.related-item { width: calc((100% - 40rpx) / 3); background: var(--surface-1); border: 1rpx solid var(--surface-3); border-radius: var(--radius-md); padding: var(--space-md) 12rpx; display: flex; flex-direction: column; align-items: center; text-align: center; box-sizing: border-box; }
.related-hover { border-color: var(--gold); }
.related-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; border: 3rpx solid transparent; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.related-avatar .poster-fallback { font-size: var(--fs-title); }
.related-cn { font-size: var(--fs-caption); font-weight: 600; color: var(--text-main); margin-top: var(--space-sm); line-height: 1.3; }
.related-shared { font-size: var(--fs-mini); color: var(--text-weak); margin-top: var(--space-xs); }

/* 阵营色 / 胶囊 / 海报阶段色系统已统一至 app.wxss 全局（Step4）*/

/* —— 数据不存在兜底 —— */
.notfound-page { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.nf-icon { width: 140rpx; height: 140rpx; border-radius: 50%; background: var(--surface-2); border: 1rpx solid var(--surface-3); color: var(--text-weak); font-size: 64rpx; display: flex; align-items: center; justify-content: center; }
.nf-title { font-size: var(--fs-title); font-weight: 600; color: var(--text-main); margin-top: var(--space-lg); }
.nf-desc { font-size: var(--fs-caption); color: var(--text-sub); margin-top: var(--space-sm); text-align: center; }
.nf-btn { margin-top: var(--space-xl); background: var(--gold); color: var(--gold-btn-text); font-weight: 600; border-radius: var(--radius-full); padding: var(--space-sm) 80rpx; font-size: var(--fs-body); }

.bottom-pad { height: 60rpx; }
