<!-- 角色详情 character · V1.1 Step6 -->

<!-- 数据不存在兜底 -->
<view class="mcu-page notfound-page" wx:if="{{notFound}}">
  <view class="nf-icon">?</view>
  <view class="nf-title">角色不存在</view>
  <view class="nf-desc">未在角色图鉴中找到这位角色，可能已被移除或链接失效。</view>
  <view class="nf-btn" bindtap="goBack">返回</view>
</view>

<view class="mcu-page" wx:else>
  <!-- Hero 区：阵营色氛围 + 真实头像（缺图 G-19 兜底） -->
  <view class="hero hero-{{faction.cls}}">
    <view class="hero-avatar {{faction.ringCls}} {{faction.factionCls}}">
      <image wx:if="{{char.avatarImg}}" class="fill-img" src="{{char.avatarImg}}" mode="aspectFill" />
      <text wx:else class="poster-fallback">{{char.avatar}}</text>
    </view>
    <view class="hero-cn">{{char.cn}}</view>
    <view class="hero-en">{{char.en}}</view>
    <view class="hero-meta">
      <view class="hero-camp pill-{{faction.cls}}">{{faction.label}}</view>
      <view class="hero-count">{{films.length}} 部关联作品</view>
    </view>
  </view>

  <!-- 基础信息 -->
  <view class="card">
    <view class="card-title">角色简介</view>
    <view class="char-note">{{char.note}}</view>
  </view>

  <!-- 首次出现作品 -->
  <view class="card" wx:if="{{first}}">
    <view class="card-title">首次出现</view>
    <view class="first-row" data-id="{{first.id}}" bindtap="goMovie" hover-class="row-hover">
      <view class="first-poster {{first.posterClass}}">
        <image wx:if="{{first.poster}}" class="fill-img" src="{{first.poster}}" mode="aspectFill" />
        <text wx:else class="poster-fallback">{{first.letter}}</text>
      </view>
      <view class="film-info">
        <view class="film-cn">{{first.cn}}</view>
        <view class="film-en">{{first.en}}<text wx:if="{{first.typeLabel}}"> · {{first.typeLabel}}</text></view>
      </view>
      <view class="phase-tag">P{{first.phase}}</view>
    </view>
  </view>

  <!-- 关联作品 -->
  <view class="card" wx:if="{{films.length}}">
    <view class="card-title">关联作品（{{films.length}}）</view>
    <view class="film-list">
      <view wx:for="{{films}}" wx:key="id"
            class="film-row" data-id="{{item.id}}" bindtap="goMovie" hover-class="row-hover">
        <view class="film-poster {{item.posterClass}}">
          <image wx:if="{{item.poster}}" class="fill-img" src="{{item.poster}}" mode="aspectFill" />
          <text wx:else class="poster-fallback">{{item.letter}}</text>
        </view>
        <view class="film-info">
          <view class="film-cn">{{item.cn}}</view>
          <view class="film-en">{{item.en}}<text wx:if="{{item.typeLabel}}"> · {{item.typeLabel}}</text></view>
        </view>
        <view class="film-status status-{{item.status}}">{{item.status==='watched'?'已看':(item.status==='watching'?'在看':'未看')}}</view>
      </view>
    </view>
  </view>

  <!-- 关系探索：关联角色 -->
  <view class="card" wx:if="{{related.length}}">
    <view class="card-title">关系探索</view>
    <view class="related-grid">
      <view wx:for="{{related}}" wx:key="id"
            class="related-item" data-id="{{item.id}}" bindtap="goCharacter" hover-class="related-hover">
        <view class="related-avatar {{item.ringCls}} {{item.factionCls}}">
          <image wx:if="{{item.avatarImg}}" class="fill-img" src="{{item.avatarImg}}" mode="aspectFill" />
          <text wx:else class="poster-fallback">{{item.avatar}}</text>
        </view>
        <view class="related-cn">{{item.cn}}</view>
        <view class="related-shared">共同出演 {{item.shared}} 部</view>
      </view>
    </view>
  </view>

  <view class="bottom-pad"></view>
</view>
