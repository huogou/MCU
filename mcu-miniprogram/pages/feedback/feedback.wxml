<!-- 我要吐槽 feedback（D10-B） - D12-A Step3-8 恢复 -->
<view class="fb-page">

  <!-- 头部 -->
  <view class="fb-hero">
    <view class="fb-hero-label">我要吐槽</view>
    <view class="fb-hero-tip">发现哪里不对？直接告诉我们。</view>
  </view>

  <!-- 表单态 -->
  <block wx:if="{{!done && !fail}}">
    <!-- 反馈类型 -->
    <view class="section-label">反馈类型</view>
    <view class="fb-types">
      <view class="fb-type {{activeType === item.key ? 'is-active' : ''}}"
            wx:for="{{types}}" wx:key="key"
            data-key="{{item.key}}" bindtap="selectType">{{item.label}}</view>
    </view>

    <!-- 反馈内容 -->
    <view class="section-label">说点什么</view>
    <textarea class="fb-textarea" placeholder="例如：钢铁侠的观看顺序标错了 / 某部电影译名不对…"
              value="{{content}}" bindinput="onContent" maxlength="500"></textarea>

    <!-- 联系方式（选填） -->
    <view class="section-label">联系方式（选填）</view>
    <input class="fb-input" placeholder="微信 / 邮箱，方便我们回访"
           value="{{contact}}" bindinput="onContact" maxlength="60" />

    <view class="fb-source">来源页面：{{source}}</view>

    <button class="fb-submit {{submitting ? 'is-loading' : ''}}" bindtap="submit" disabled="{{submitting}}">
      {{submitting ? '提交中…' : '提交吐槽'}}
    </button>
  </block>

  <!-- 成功态 -->
  <block wx:elif="{{done}}">
    <view class="fb-result">
      <view class="fb-result-icon">√</view>
      <view class="fb-result-title">已收到，谢谢吐槽</view>
      <view class="fb-result-tip">我们会尽快核对，你的反馈会直接进入纠错流程。</view>
      <button class="fb-submit" bindtap="goAgain">再提一条</button>
      <button class="fb-link" bindtap="back">返回</button>
    </view>
  </block>

  <!-- 失败态（可重试） -->
  <block wx:else>
    <view class="fb-result">
      <view class="fb-result-icon is-fail">!</view>
      <view class="fb-result-title">提交失败了</view>
      <view class="fb-result-tip">网络有点小问题，稍后再试一次就好。</view>
      <button class="fb-submit" bindtap="retry">重试</button>
      <button class="fb-link" bindtap="back">返回</button>
    </view>
  </block>

  <view class="fb-bottom-space"></view>
</view>
