/* feedback 我要吐槽 · V1.2 统一视觉 */

.fb-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 0 var(--page-x);
  box-sizing: border-box;
}

.fb-hero { padding: var(--space-xl) 4rpx var(--space-md); }
.fb-hero-label { font-size: var(--fs-display); font-weight: 700; color: var(--text-main); }
.fb-hero-tip { margin-top: 10rpx; font-size: var(--fs-body); color: var(--text-sub); }

.section-label {
  margin: var(--space-lg) 4rpx var(--space-sm);
  font-size: var(--fs-body); font-weight: 600; color: var(--text-sub);
}

/* 类型选择：胶囊，选中金边金底 */
.fb-types { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
.fb-type {
  padding: var(--space-sm) var(--space-md); font-size: var(--fs-body); color: var(--text-sub);
  background: var(--surface-2); border: 2rpx solid var(--surface-3);
  border-radius: var(--radius-full);
}
.fb-type.is-active {
  color: var(--gold); border-color: var(--gold);
  background: var(--gold-a12);
}

.fb-textarea {
  width: 100%; box-sizing: border-box; min-height: 220rpx;
  padding: var(--space-md); font-size: var(--fs-body); color: var(--text-main);
  background: var(--surface-2); border: 2rpx solid var(--surface-3);
  border-radius: var(--radius-md); line-height: 1.6;
}

.fb-submit {
  margin-top: var(--space-xl); height: 92rpx; line-height: 92rpx;
  font-size: var(--fs-title); font-weight: 600; color: var(--gold-btn-text);
  background: var(--gold); border-radius: var(--radius-md); border: none;
  text-align: center; padding: 0;
}
.fb-submit.is-loading { opacity: 0.7; }
.fb-link {
  margin-top: var(--space-sm); height: 80rpx; line-height: 80rpx;
  font-size: var(--fs-body); color: var(--text-sub);
  background: transparent; border: none;
  text-align: center; padding: 0;
}

/* 结果态 */
.fb-result { padding: 120rpx var(--space-md); text-align: center; }
.fb-result-icon {
  width: 120rpx; height: 120rpx; margin: 0 auto var(--space-lg);
  border-radius: 50%; background: var(--success-a15);
  color: var(--success); font-size: 64rpx; line-height: 120rpx; font-weight: 700;
}
.fb-result-icon.is-fail { background: var(--error-a15); color: var(--error); }
.fb-result-title { font-size: var(--fs-title); font-weight: 700; color: var(--text-main); }
.fb-result-tip { margin: var(--space-sm) 0 var(--space-xs); font-size: var(--fs-body); color: var(--text-sub); line-height: 1.6; }

.fb-bottom-space { height: 60rpx; }
