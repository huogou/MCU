/* feedback 我要吐槽（D10-B） - D12-A Step3-8 恢复；全 Token 化，与相邻页视觉一致 */

.fb-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 0 24rpx;
  box-sizing: border-box;
}

.fb-hero { padding: 40rpx 4rpx 24rpx; }
.fb-hero-label { font-size: 44rpx; font-weight: 700; color: var(--text-main); }
.fb-hero-tip { margin-top: 10rpx; font-size: 26rpx; color: var(--text-sub); }

.section-label {
  margin: 32rpx 4rpx 16rpx;
  font-size: 28rpx; font-weight: 600; color: var(--text-sub);
}

/* 类型选择：胶囊，选中金边金底 */
.fb-types { display: flex; flex-wrap: wrap; gap: 16rpx; }
.fb-type {
  padding: 16rpx 24rpx; font-size: 26rpx; color: var(--text-sub);
  background: var(--surface-2); border: 2rpx solid var(--surface-3);
  border-radius: 999rpx;
}
.fb-type.is-active {
  color: var(--gold); border-color: var(--gold);
  background: var(--gold-a12);
}

.fb-textarea {
  width: 100%; box-sizing: border-box; min-height: 220rpx;
  padding: 24rpx; font-size: 28rpx; color: var(--text-main);
  background: var(--surface-2); border: 2rpx solid var(--surface-3);
  border-radius: 16rpx; line-height: 1.6;
}
.fb-input {
  width: 100%; box-sizing: border-box; height: 88rpx; padding: 0 24rpx;
  font-size: 28rpx; color: var(--text-main);
  background: var(--surface-2); border: 2rpx solid var(--surface-3);
  border-radius: 16rpx;
}

.fb-source { margin: 16rpx 4rpx 0; font-size: 22rpx; color: var(--text-weak); }

.fb-submit {
  margin-top: 40rpx; height: 92rpx; line-height: 92rpx;
  font-size: 30rpx; font-weight: 600; color: var(--bg);
  background: var(--gold); border-radius: 16rpx; border: none;
}
.fb-submit.is-loading { opacity: 0.7; }
.fb-link {
  margin-top: 16rpx; height: 80rpx; line-height: 80rpx;
  font-size: 28rpx; color: var(--text-sub);
  background: transparent; border: none;
}

/* 结果态 */
.fb-result { padding: 120rpx 24rpx; text-align: center; }
.fb-result-icon {
  width: 120rpx; height: 120rpx; margin: 0 auto 32rpx;
  border-radius: 50%; background: var(--success-a15);
  color: var(--success); font-size: 64rpx; line-height: 120rpx; font-weight: 700;
}
.fb-result-icon.is-fail { background: var(--error-a15); color: var(--error); }
.fb-result-title { font-size: 34rpx; font-weight: 700; color: var(--text-main); }
.fb-result-tip { margin: 16rpx 0 8rpx; font-size: 26rpx; color: var(--text-sub); line-height: 1.6; }

.fb-bottom-space { height: 60rpx; }
