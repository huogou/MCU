/* 首页 home（Tab1）· V1.2 重构样式（Final 校准）
 * 依据：《MCU-V1.2-UI-Design-System-Final.md》（统一终稿）
 * 本版按设计侧《首页V1.2设计验收意见》P0+P1 校准：
 *   P0① CTA 字号 34→28rpx；P0② 移除全部 500 字重（4处→400）+ movie-progress 600→400；
 *   P0③ 角色卡 align-items center；P1④ movie-phase 24→28rpx、weak→sub；
 *   P1⑤ 进度值 600→400；P1⑥ card-title margin-bottom 32→24rpx；另按 Final§⑤ 补故事线 "›"。
 * 颜色一律 var()，组件规则零裸 hex；字号 5 级、卡片 3 级、模块间距 48rpx。
 */

.home-page {
  padding: var(--space-2xl) var(--page-x);   /* 顶/底 64rpx，左右 32rpx */
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
}

/* 模块统一间距 48rpx（段落感，呼吸感基础） */
.brand-area,
.continue-card,
.my-route,
.section {
  margin-bottom: var(--space-xl);
}

/* —— ① 品牌入口（金色竖条，Final§2.2①：10×64rpx，无图标） —— */
.brand-area {
  display: flex;
  align-items: center;
}
.brand-mark {
  width: 10rpx;
  height: 64rpx;
  border-radius: 6rpx;
  background: var(--gold);
  margin-right: 20rpx;
  flex-shrink: 0;
}
.brand-text { min-width: 0; }
.brand-title {
  font-size: var(--fs-display);         /* 48rpx Display */
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.25;
}
.brand-sub {
  font-size: var(--fs-body);            /* 28rpx Body */
  color: var(--text-sub);
  margin-top: 6rpx;
}

/* 卡片标题：安静退后，用 --text-sub（焦点留给卡片内容） */
.card-title {
  font-size: var(--fs-title);            /* 34rpx Title */
  font-weight: 600;
  color: var(--text-sub);
  margin-bottom: var(--space-md);        /* 24rpx（Final §1.7 模块标题与内容间距） */
}

/* —— ② 继续观看 Hero Card（Final §2.2②） —— */
.continue-card {
  /* 在全局 .card-hero 基础上追加金色微渐变 + 金色边框 */
  background: linear-gradient(135deg, var(--gold-a06), var(--surface-1));
  border: 2rpx solid var(--gold-a20);
}
.continue-body {
  display: flex;
  flex-direction: column;               /* 垂直布局：信息在上，全宽按钮在下 */
}
.continue-meta { min-width: 0; }
.movie-name {
  font-size: var(--fs-title);            /* 34rpx */
  font-weight: 600;                      /* Final §②：600 */
  color: var(--text-main);
}
.movie-phase {
  font-size: var(--fs-body);             /* 28rpx Body（Final §②，P1④ 校准） */
  color: var(--text-sub);                /* 描述层（P1④ 校准） */
  margin-top: var(--space-xs);
}
.movie-progress-label {
  font-size: var(--fs-mini);             /* 20rpx Mini */
  color: var(--text-weak);
  margin-top: var(--space-sm);
}
.movie-progress {
  font-size: var(--fs-caption);          /* 24rpx */
  color: var(--gold);
  font-weight: 400;                      /* Final §②：400（P1⑤/P0② 校准，金色已承担强调） */
  margin-top: var(--space-xs);
}

/* 强调按钮（Primary CTA，全页唯一金色实心按钮，全宽） */
.btn-accent {
  width: 100%;
  box-sizing: border-box;
  background: var(--gold);
  color: var(--gold-btn-text);
  font-size: var(--fs-body);             /* 28rpx（Final §1.9 Primary，P0① 校准） */
  font-weight: 600;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  margin-top: var(--space-lg);
}
.btn-hover { opacity: 0.85; }

/* Ghost 按钮（轻量文字链接，金色） */
.btn-ghost {
  display: inline-block;
  color: var(--gold);
  font-size: var(--fs-body);             /* 28rpx */
  font-weight: 400;                      /* P0② 校准（Final 禁用 500） */
  margin-top: var(--space-lg);
}
.btn-ghost.btn-hover { opacity: 0.7; }

/* —— ③ 我的路线（Content Card，纵向堆叠；Final §2.2③） —— */
.route-body { display: block; }
.route-info { min-width: 0; }
.route-name {
  font-size: var(--fs-title);            /* 34rpx */
  font-weight: 600;
  color: var(--text-main);
}
.route-progress {
  font-size: var(--fs-caption);          /* 24rpx */
  color: var(--text-weak);
  margin-top: var(--space-xs);
}
.route-next { margin-top: var(--space-lg); }
.next-label {
  font-size: var(--fs-mini);             /* 20rpx */
  color: var(--text-weak);
}
.next-name {
  font-size: var(--fs-body);             /* 28rpx */
  font-weight: 400;                      /* P0② 校准 */
  color: var(--gold);                    /* Final §③：推荐片名金色 */
  margin-top: var(--space-xs);
}
.route-done {
  font-size: var(--fs-caption);          /* 24rpx */
  color: var(--text-weak);
  margin-top: var(--space-lg);
}

/* —— ④ 宇宙探索入口（纵向全宽三行；Final §2.2④） —— */
.module-title {
  font-size: var(--fs-title);            /* 34rpx Title，用 --text-main 突出模块标题 */
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: var(--space-md);        /* 24rpx（Final §1.7） */
}
.explore-row { display: block; }
.explore-card {
  display: flex;
  align-items: center;
  background: var(--surface-2);
  border-radius: 12rpx;
  min-height: 72rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  margin-bottom: var(--space-sm);
}
.explore-card:last-child { margin-bottom: 0; }
.explore-ic-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: var(--surface-1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.explore-ic {
  font-size: 28rpx;
  line-height: 1;
  color: var(--gold);                    /* Final §2.2④：图标金色 */
}
.explore-title {
  font-size: var(--fs-body);             /* 28rpx */
  font-weight: 400;                      /* P0② 校准 */
  color: var(--text-main);
  margin-left: 20rpx;
}
.explore-arrow {
  margin-left: auto;
  font-size: var(--fs-caption);          /* 24rpx chevron，Unicode 占位 */
  color: var(--text-weak);
}
.explore-hover { border: 1rpx solid var(--gold-a20); }

/* —— ⑤ 热门角色（横向滚动；Final §2.2⑤：卡 156rpx / 头像 88rpx / 居中） —— */
.char-scroll {
  width: 100%;
  white-space: nowrap;
}
.char-row {
  display: flex;
  flex-wrap: nowrap;
}
.char-card {
  flex-shrink: 0;
  width: 156rpx;
  display: flex;
  flex-direction: column;
  align-items: center;                   /* P0③ 校准（Final §⑤：居中） */
  background: var(--surface-2);
  border-radius: 12rpx;
  padding: 20rpx 12rpx;
  box-sizing: border-box;
  margin-right: var(--space-sm);
}
.char-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-display-sm);       /* 40rpx 首字 */
  font-weight: 700;
  color: var(--white-a60);
  margin-bottom: var(--space-sm);
}
.char-name {
  font-size: var(--fs-body);             /* 28rpx */
  color: var(--text-main);
  font-weight: 400;                      /* P0② 校准 */
}
.char-count {
  font-size: var(--fs-caption);          /* 24rpx */
  color: var(--text-weak);
  margin-top: 6rpx;
}
.char-story {
  font-size: var(--fs-caption);          /* 24rpx */
  color: var(--gold);
  font-weight: 400;
  margin-top: 12rpx;
}
.char-hover { border: 1rpx solid var(--gold-a20); }

/* —— ⑥ 最近观看（横向滚动；Final §2.2⑥） —— */
.recent-scroll {
  width: 100%;
  white-space: nowrap;
}
.recent-row {
  display: flex;
  flex-wrap: nowrap;
}
.recent-item {
  flex-shrink: 0;
  width: 120rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
}
.recent-poster {
  width: 120rpx;
  height: 160rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-text {
  font-size: var(--fs-display);          /* 48rpx */
  font-weight: 700;
  color: var(--white-a50);
}
.recent-name {
  font-size: var(--fs-caption);          /* 24rpx */
  color: var(--text-sub);
  margin-top: 12rpx;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recent-hover { opacity: 0.85; }

.empty-hint {
  font-size: var(--fs-body);             /* 28rpx */
  color: var(--text-weak);
  padding: var(--space-xl) 0;
  text-align: center;
}

/* —— 海报/头像阶段色（消费全局 phase token，仅内容标识） —— */
.poster-p1 { background: linear-gradient(135deg, var(--p1), var(--p1-a60)); }
.poster-p2 { background: linear-gradient(135deg, var(--p2), var(--p2-a60)); }
.poster-p3 { background: linear-gradient(135deg, var(--p3), var(--p3-a60)); }
.poster-p4 { background: linear-gradient(135deg, var(--p4), var(--p4-a60)); }
.poster-p5 { background: linear-gradient(135deg, var(--p5), var(--p5-a60)); }
.poster-p6 { background: linear-gradient(135deg, var(--p6), var(--p6-a60)); }
