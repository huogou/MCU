/* 首页 home（Tab1）· V1.2 视觉还原样式（按《MCU-V1.2视觉验收清单》H-01~H-18）
 * 依据：《页面视觉升级方案》§2.3 + 《开发视觉标注》
 * 颜色一律 var()，组件规则零裸 hex；字号 5 级、圆角 5 级、卡片 3 级。
 * 模块间距 --space-xl(56) / 标题下距 --space-md(28) / 页边距 --page-x(36)。
 */

.home-page {
  padding: var(--space-2xl) var(--page-x);   /* 顶/底 var(--space-2xl)，左右 36rpx */
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
}

.section { margin-bottom: var(--space-xl); }
.section:last-child { margin-bottom: 0; }

/* 模块标题（36rpx/600/main，下距 28rpx） */
.module-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: var(--space-md);
}

/* —— ① 旅程进度卡（H-01~H-04） —— */
.journey-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, var(--surface-0), var(--surface-1));
  border: 1rpx solid var(--surface-3);
  border-radius: var(--radius-xl);
  margin-bottom: var(--space-xl);
}
/* 顶部「宇宙背景」占位：home-bg.jpg 缺失 → 宇宙渐变占位（G-18 合规） */
.journey-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 200rpx;
  background:
    radial-gradient(140rpx 90rpx at 18% 28%, var(--gold-a10), transparent 70%),
    radial-gradient(180rpx 110rpx at 82% 18%, var(--accent-blue-a10), transparent 70%),
    linear-gradient(180deg, var(--surface-0), transparent);
  opacity: 0.9;
  pointer-events: none;
}
.journey-inner {
  position: relative;
  padding: 36rpx;
}
.journey-label {
  font-size: var(--fs-caption);          /* 24rpx */
  font-weight: 400;
  color: var(--text-sub);
  letter-spacing: 2rpx;
}
.journey-num {
  font-size: var(--fs-display);          /* 56rpx */
  font-weight: 700;
  color: var(--gold);
  line-height: 1.2;
  margin-top: 12rpx;
}
.journey-phase {
  font-size: var(--fs-caption);          /* 24rpx */
  font-weight: 400;
  color: var(--text-weak);
  margin-top: var(--space-xs);
}
.journey-movie {
  display: flex;
  align-items: center;
  margin-top: var(--space-lg);
}
.jm-poster {
  width: 120rpx;
  height: 180rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.jm-poster text {
  font-size: var(--fs-display-sm);       /* 44rpx 首字 */
  font-weight: 700;
  color: var(--white-a60);
}
.jm-info { min-width: 0; margin-left: var(--space-md); }
.jm-name {
  font-size: var(--fs-body);             /* 28rpx */
  font-weight: 600;
  color: var(--text-main);
}
.jm-en {
  font-size: var(--fs-mini);             /* 22rpx */
  font-weight: 400;
  color: var(--text-sub);
  margin-top: 4rpx;
}
.jm-phase {
  font-size: var(--fs-mini);             /* 22rpx */
  font-weight: 400;
  color: var(--text-weak);
  margin-top: 4rpx;
}
.jm-status {
  display: inline-block;
  font-size: var(--fs-mini);             /* 22rpx */
  font-weight: 600;
  color: var(--gold);
  background: var(--gold-a10);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  margin-top: var(--space-sm);
}
.jm-status.st-done {
  color: var(--text-weak);
  background: var(--surface-3);
}

/* —— ② 推荐下一部大卡（H-05~H-08） —— */
.rec-card {
  background: var(--surface-1);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-hero);
  margin-bottom: var(--space-xl);
}
.rec-poster-wrap {
  position: relative;
  width: 100%;
  height: 360rpx;
}
.rec-poster {
  width: 100%;
  height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rec-poster text {
  font-size: var(--fs-display);          /* 56rpx 首字 */
  font-weight: 700;
  color: var(--white-a50);
}
/* 海报底部渐变，保证文字可读 */
.rec-poster-mask {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 200rpx;
  background: linear-gradient(to top, var(--surface-1), transparent);
  pointer-events: none;
}
.rec-body { padding: var(--space-md); }
.rec-tag {
  font-size: var(--fs-mini);             /* 22rpx */
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 2rpx;
}
.rec-phase {
  float: right;
  font-size: var(--fs-mini);             /* 22rpx */
  font-weight: 400;
  color: var(--text-weak);
}
.rec-name {
  font-size: var(--fs-title);            /* 36rpx */
  font-weight: 700;
  color: var(--text-main);
  margin-top: var(--space-xs);
}
.rec-sub {
  font-size: var(--fs-caption);          /* 24rpx */
  font-weight: 400;
  color: var(--text-sub);
  margin-top: 4rpx;
}
.rec-reason {
  font-size: var(--fs-caption);          /* 24rpx */
  font-weight: 400;
  color: var(--text-sub);
  line-height: 1.5;
  margin-top: var(--space-sm);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 强调按钮（全页唯一金色实心，H-07/H-18） */
.btn-accent {
  width: 100%;
  box-sizing: border-box;
  background: var(--gold);
  color: var(--gold-btn-text);
  font-size: var(--fs-body);             /* 28rpx */
  font-weight: 600;
  border-radius: var(--radius-md);
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  margin-top: var(--space-lg);
  box-shadow: var(--glow-gold);
}
.btn-hover { opacity: 0.85; }

/* —— ③ 宇宙入口 3 列（H-09~H-11） —— */
.exp-row {
  display: flex;
  gap: 16rpx;
}
.exp-card {
  flex: 1;
  height: 200rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: var(--space-sm);
  box-sizing: border-box;
}
.exp-blue   { background: linear-gradient(135deg, var(--accent-blue-a10),   var(--surface-2)); }
.exp-red    { background: linear-gradient(135deg, var(--accent-red-a10),    var(--surface-2)); }
.exp-purple { background: linear-gradient(135deg, var(--accent-purple-a10), var(--surface-2)); }
.exp-ic {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
  color: var(--gold);
}
.exp-title {
  font-size: var(--fs-caption);          /* 24rpx */
  font-weight: 600;
  color: var(--text-main);
}
.exp-hover { border: 1rpx solid var(--gold-a20); }

/* —— ④ 热门角色（横滚）（H-12~H-13） —— */
.char-scroll {
  width: 100%;
  white-space: nowrap;
}
.char-row {
  display: flex;
  flex-wrap: nowrap;
}
.char-card {
  flex-shrink: 0;
  width: 168rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--surface-2);
  border-radius: var(--radius-md);
  padding: 24rpx 16rpx;
  box-sizing: border-box;
  margin-right: var(--space-sm);
}
.char-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 3rpx solid transparent;        /* 由 fring-* 覆盖阵营色 */
  display: flex;
  align-items: center;
  justify-content: center;
}
.char-img { width: 100%; height: 100%; }
.char-initial {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-display-sm);       /* 44rpx 首字 */
  font-weight: 700;
  color: var(--white-a70);
}
.char-name {
  font-size: var(--fs-body);             /* 28rpx */
  font-weight: 600;
  color: var(--text-main);
  margin-top: 16rpx;
}
.char-faction {
  font-size: var(--fs-mini);             /* 22rpx */
  font-weight: 400;
  margin-top: 6rpx;
}
.char-hover { border: 1rpx solid var(--gold-a20); }

/* —— ⑤ 最近观看（横滚）（H-14~H-15） —— */
.recent-scroll {
  width: 100%;
  white-space: nowrap;
}
.recent-row {
  display: flex;
  flex-wrap: nowrap;
}
.recent-item {
  flex-shrink: 0;
  width: 120rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
}
.recent-poster {
  width: 120rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.recent-img { width: 100%; height: 100%; }
.poster-text {
  font-size: var(--fs-display);          /* 48rpx */
  font-weight: 700;
  color: var(--white-a50);
}
.recent-name {
  font-size: var(--fs-caption);          /* 24rpx */
  font-weight: 400;
  color: var(--text-sub);
  margin-top: 12rpx;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recent-hover { opacity: 0.85; }

.empty-hint {
  font-size: var(--fs-body);             /* 28rpx */
  font-weight: 400;
  color: var(--text-weak);
  padding: var(--space-xl) 0;
  text-align: center;
}

/* 阵营色 / 海报阶段色系统已统一至 app.wxss 全局（Step4 全局统一）*/
