/* 首页 home（Tab1）· V1.2 重构样式
 * V1.2 色板已统一到全局 app.wxss，首页不再覆盖 token。
 * 单位换算：1px = 2rpx（750rpx=375pt）。
 */

.home-page {
  padding: var(--page-x);
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
}

/* 模块间距 24px */
.brand-area,
.continue-card,
.my-route,
.section { margin-bottom: 48rpx; }
.spacer-lg { height: 24rpx; }

/* —— ① 品牌区域 —— */
.brand-area {
  display: flex;
  align-items: center;
  padding: 8rpx 0 4rpx;
}
.brand-mark {
  width: 10rpx;
  height: 64rpx;
  border-radius: 6rpx;
  background: var(--gold);
  margin-right: 20rpx;
  flex-shrink: 0;
}
.brand-title {
  font-size: 48rpx;          /* 标题 24px */
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.25;
}
.brand-sub {
  font-size: 28rpx;          /* 描述 14px */
  color: var(--text-sub);
  margin-top: 6rpx;
}

/* —— 通用卡片 —— */
.card {
  background: var(--surface-1);
  border-radius: 24rpx;
  padding: var(--space-lg);
  box-sizing: border-box;
}
.card-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 20rpx;
}

/* —— 强调按钮（仅用于 开始/继续/当前推荐，禁止大面积使用） —— */
.btn-accent {
  background: var(--gold);
  color: var(--gold-btn-text);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 24rpx;      /* 按钮圆角 12px */
  padding: 18rpx 40rpx;
  text-align: center;
  flex-shrink: 0;
  margin-left: 24rpx;
}
.btn-sm { padding: 14rpx 32rpx; }
.btn-hover { opacity: 0.88; }

/* —— ② 继续观看卡 —— */
.continue-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.continue-meta { flex: 1; min-width: 0; }
.movie-name {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--text-main);
}
.movie-phase {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}
.movie-progress-label {
  font-size: 24rpx;          /* 辅助 12px */
  color: var(--text-weak);
  margin-top: 10rpx;
}
.movie-progress {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-top: 2rpx;
}

/* —— ③ 我的路线 —— */
.route-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.route-info { flex: 1; min-width: 0; margin-right: 24rpx; }
.route-name {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--text-main);
}
.route-progress {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}
.route-next {
  text-align: right;
  flex-shrink: 0;
}
.next-label {
  font-size: 24rpx;
  color: var(--text-weak);
}
.next-name {
  font-size: 28rpx;
  color: var(--gold);
  font-weight: 600;
  margin-top: 4rpx;
}

/* —— ④ 宇宙探索入口（统一入口行式） —— */
.module-title {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 24rpx;
}
.explore-row {
  display: flex;
  flex-direction: column;
}
.explore-card {
  display: flex;
  align-items: center;
  background: var(--surface-2);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}
.explore-card:last-child { margin-bottom: 0; }
.explore-ic {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--surface-1);
  color: var(--gold);
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.explore-body { flex: 1; min-width: 0; }
.explore-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}
.explore-desc {
  font-size: 24rpx;
  color: var(--text-weak);
  margin-top: 6rpx;
}
.explore-arrow {
  font-size: 40rpx;
  color: var(--text-weak);
  flex-shrink: 0;
  margin-left: 16rpx;
}
.explore-hover { border: 1rpx solid var(--gold); }

/* —— ⑤ 热门角色（故事入口） —— */
.char-row {
  display: flex;
  justify-content: space-between;
}
.char-card {
  flex: 1;
  background: var(--surface-2);
  border-radius: 16rpx;
  padding: 28rpx 12rpx;
  margin-right: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}
.char-card:last-child { margin-right: 0; }
.char-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--white);
  margin-bottom: 16rpx;
}
.char-name {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}
.char-count {
  font-size: 24rpx;          /* 辅助 12px */
  color: var(--text-weak);
  margin-top: 6rpx;
}
.char-story {
  font-size: 24rpx;
  color: var(--gold);
  margin-top: 12rpx;
}
.char-hover { border: 1rpx solid var(--gold); }

/* —— ⑥ 最近观看（横向卡片） —— */
.recent-row {
  display: flex;
  overflow-x: auto;
  white-space: nowrap;
}
.recent-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
}
.recent-poster {
  width: 120rpx;
  height: 160rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-text {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--white);
}
.recent-name {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 12rpx;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recent-hover { opacity: 0.85; }

.empty-hint {
  font-size: 28rpx;
  color: var(--text-weak);
  padding: 32rpx 0;
  text-align: center;
}

/* —— 海报阶段色兜底（与全局 phase token 一致，规范未重定义阶段色） —— */
.poster-p1 { background: linear-gradient(135deg, var(--p1), var(--p1-a60)); }
.poster-p2 { background: linear-gradient(135deg, var(--p2), var(--p2-a60)); }
.poster-p3 { background: linear-gradient(135deg, var(--p3), var(--p3-a60)); }
.poster-p4 { background: linear-gradient(135deg, var(--p4), var(--p4-a60)); }
.poster-p5 { background: linear-gradient(135deg, var(--p5), var(--p5-a60)); }
.poster-p6 { background: linear-gradient(135deg, var(--p6), var(--p6-a60)); }
