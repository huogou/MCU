/* 首页 home（Tab1）· V1.2 重构样式
 * 规范来源：《MCU观影导航 V1.2 UI Design System》（2026-08-25）
 * 调色板在 .home-page 作用域覆盖为 V1.2 值，组件规则一律引用 CSS 变量（禁裸 hex）。
 * 单位换算：规范 px 按移动端设计基准（375pt 画布）换算 rpx，1px = 2rpx（750rpx=375pt）。
 * 阶段色 poster-pN 沿用既有 phase token（规范未重定义阶段色，保持全局一致）。
 */

/* —— V1.2 调色板（仅作用于首页，不污染其他页面） —— */
.home-page {
  --bg: #080B12;
  --surface-1: #161D2B;
  --surface-2: #202938;
  --gold: #F2B233;
  --gold-btn-text: #1A1206;
  --text-main: #E8ECF4;
  --text-sub: #8E98AA;
  --text-weak: #657083;
  --line: #202938;
  --white: #FFFFFF;

  padding: 32rpx;            /* 页面左右边距 16px */
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
}

/* 模块间距 24px */
.brand-area,
.continue-card,
.quick-row,
.route-rec,
.section { margin-bottom: 48rpx; }
.spacer-lg { height: 24rpx; }

/* —— ① 顶部品牌区 —— */
.brand-area {
  display: flex;
  align-items: center;
  padding: 8rpx 0 4rpx;
}
.brand-mark {
  width: 10rpx;
  height: 64rpx;
  border-radius: 6rpx;
  background: var(--gold);
  margin-right: 20rpx;
  flex-shrink: 0;
}
.brand-title {
  font-size: 48rpx;          /* 页面标题 24px */
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.25;
}
.brand-sub {
  font-size: 28rpx;          /* 描述 14px */
  color: var(--text-sub);
  margin-top: 6rpx;
}

/* —— 通用卡片 —— */
.card {
  background: var(--surface-1);   /* 主卡片 #161D2B */
  border-radius: 32rpx;           /* 卡片圆角 16px */
  padding: 32rpx;                 /* 卡片内部 16px */
  box-sizing: border-box;
}
.card-title {
  font-size: 34rpx;          /* 卡片标题 17px */
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 20rpx;
}

/* —— ② 继续观看卡 —— */
.continue-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.continue-meta { flex: 1; min-width: 0; }
.movie-name {
  font-size: 36rpx;          /* 模块标题级 18px */
  font-weight: 700;
  color: var(--text-main);
}
.movie-phase {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}
.movie-progress {
  font-size: 24rpx;          /* 辅助 12px */
  color: var(--text-weak);
  margin-top: 6rpx;
}

/* —— 强调按钮（仅用于 开始/继续/当前推荐，禁止大面积使用） —— */
.btn-accent {
  background: var(--gold);
  color: var(--gold-btn-text);
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 24rpx;      /* 按钮圆角 12px */
  padding: 18rpx 40rpx;
  text-align: center;
  flex-shrink: 0;
  margin-left: 24rpx;
}
.btn-sm { padding: 14rpx 32rpx; }
.btn-hover { opacity: 0.88; }

/* —— ③ 三个快捷入口（横向卡片，统一 icon） —— */
.quick-row {
  display: flex;
  justify-content: space-between;
}
.quick-card {
  flex: 1;
  background: var(--surface-2);   /* 次级卡片 #202938 */
  border-radius: 32rpx;
  padding: 32rpx 16rpx;
  margin-right: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}
.quick-card:last-child { margin-right: 0; }
.quick-ic {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 16rpx;
}
.quick-title {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}
.quick-hover { border: 1rpx solid var(--gold); }

/* —— ④ 新手路线推荐 —— */
.route-rec {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.route-rec-info { flex: 1; min-width: 0; }
.route-rec-info .card-title { margin-bottom: 10rpx; }
.route-rec-sub {
  font-size: 28rpx;
  color: var(--text-sub);
}

/* —— ⑤ 热门角色 —— */
.module-title {
  font-size: 36rpx;          /* 模块标题 18px */
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 24rpx;
}
.char-row {
  display: flex;
  justify-content: space-between;
}
.char-card {
  flex: 1;
  background: var(--surface-2);
  border-radius: 32rpx;
  padding: 28rpx 12rpx;
  margin-right: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}
.char-card:last-child { margin-right: 0; }
.char-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--white);
  margin-bottom: 16rpx;
}
.char-name {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}
.char-count {
  font-size: 24rpx;          /* 辅助 12px */
  color: var(--text-weak);
  margin-top: 6rpx;
}

/* —— ⑥ 最近观看（横向卡片） —— */
.recent-row {
  display: flex;
  overflow-x: auto;
  white-space: nowrap;
}
.recent-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
}
.recent-poster {
  width: 120rpx;
  height: 160rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-text {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--white);
}
.recent-name {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 12rpx;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recent-hover { opacity: 0.85; }

.empty-hint {
  font-size: 28rpx;
  color: var(--text-weak);
  padding: 32rpx 0;
  text-align: center;
}

/* —— 海报阶段色兜底（与全局 phase token 一致，规范未重定义阶段色） —— */
.poster-p1 { background: linear-gradient(135deg, var(--p1), var(--p1-a60)); }
.poster-p2 { background: linear-gradient(135deg, var(--p2), var(--p2-a60)); }
.poster-p3 { background: linear-gradient(135deg, var(--p3), var(--p3-a60)); }
.poster-p4 { background: linear-gradient(135deg, var(--p4), var(--p4-a60)); }
.poster-p5 { background: linear-gradient(135deg, var(--p5), var(--p5-a60)); }
.poster-p6 { background: linear-gradient(135deg, var(--p6), var(--p6-a60)); }
