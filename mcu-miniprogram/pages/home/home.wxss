/* 首页 home（Tab1）· V1.2 重构样式
 * 消费全局 app.wxss 的 Token 与卡片/工具类（.card-hero/.card-content/.card-compact）。
 * 设计约束：全部 var() 引用，组件规则零裸 hex；字号 5 级、卡片 3 级、模块间距 48rpx。
 */

.home-page {
  padding: var(--space-2xl) var(--page-x);   /* 顶/底 64rpx，左右 32rpx */
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
}

/* 模块统一间距 48rpx（段落感，呼吸感基础） */
.brand-area,
.continue-card,
.my-route,
.section {
  margin-bottom: var(--space-xl);
}

/* —— ① 品牌入口（安静存在，不抢焦点） —— */
.brand-area {
  display: flex;
  align-items: center;
}
.brand-mark {
  width: 48rpx;
  height: 48rpx;
  background: var(--gold-a20);
  border-radius: 12rpx;                 /* clip-path 不支持时的兜底 */
  clip-path: polygon(50% 0%, 100% 18%, 100% 58%, 50% 100%, 0% 58%, 0% 18%);
  margin-right: var(--space-sm);
  flex-shrink: 0;
}
.brand-text { min-width: 0; }
.brand-title {
  font-size: var(--fs-display);         /* 48rpx Display */
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.3;
}
.brand-sub {
  font-size: var(--fs-body);            /* 28rpx Body */
  color: var(--text-sub);
  margin-top: var(--space-xs);
}

/* 卡片标题：安静退后，用 --text-sub（焦点留给卡片内容） */
.card-title {
  font-size: var(--fs-title);            /* 34rpx Title */
  font-weight: 600;
  color: var(--text-sub);
  margin-bottom: var(--space-lg);
}

/* —— ② 继续观看 Hero Card —— */
.continue-card {
  /* 在全局 .card-hero 基础上追加金色微渐变 + 金色边框 */
  background: linear-gradient(135deg, var(--gold-a06), var(--surface-1));
  border: 2rpx solid var(--gold-a20);
}
.continue-body {
  display: flex;
  flex-direction: column;
}
.continue-meta { min-width: 0; }
.movie-name {
  font-size: var(--fs-title);            /* 34rpx */
  font-weight: 600;
  color: var(--text-main);
}
.movie-phase {
  font-size: var(--fs-caption);          /* 24rpx Caption */
  color: var(--text-weak);
  margin-top: var(--space-xs);
}
.movie-progress-label {
  font-size: var(--fs-mini);             /* 20rpx Mini */
  color: var(--text-weak);
  margin-top: var(--space-sm);
}
.movie-progress {
  font-size: var(--fs-caption);          /* 24rpx */
  color: var(--gold);
  font-weight: 600;
  margin-top: var(--space-xs);
}

/* 强调按钮（Primary CTA，全页唯一金色实心按钮，全宽） */
.btn-accent {
  width: 100%;
  box-sizing: border-box;
  background: var(--gold);
  color: var(--gold-btn-text);
  font-size: var(--fs-title);            /* 34rpx */
  font-weight: 600;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  margin-top: var(--space-lg);
}
.btn-hover { opacity: 0.85; }

/* Ghost 按钮（轻量文字链接，金色） */
.btn-ghost {
  display: inline-block;
  color: var(--gold);
  font-size: var(--fs-body);             /* 28rpx */
  font-weight: 500;
  margin-top: var(--space-lg);
}
.btn-ghost.btn-hover { opacity: 0.7; }

/* —— ③ 我的路线（Content Card） —— */
.route-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.route-info { flex: 1; min-width: 0; margin-right: var(--space-lg); }
.route-name {
  font-size: var(--fs-title);            /* 34rpx */
  font-weight: 600;
  color: var(--text-main);
}
.route-progress {
  font-size: var(--fs-caption);          /* 24rpx */
  color: var(--text-weak);
  margin-top: var(--space-xs);
}
.route-next { text-align: right; flex-shrink: 0; }
.next-label {
  font-size: var(--fs-mini);             /* 20rpx */
  color: var(--text-weak);
}
.next-name {
  font-size: var(--fs-body);             /* 28rpx */
  color: var(--text-main);
  margin-top: var(--space-xs);
}
.route-done {
  font-size: var(--fs-caption);          /* 24rpx */
  color: var(--text-weak);
  margin-top: var(--space-lg);
}

/* —— ④ 宇宙探索入口（三卡横向等分，仅图标+名称，无描述无箭头） —— */
.module-title {
  font-size: var(--fs-title);            /* 34rpx Title，用 --text-main 突出模块标题 */
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: var(--space-lg);
}
.explore-row {
  display: flex;
  justify-content: space-between;
}
.explore-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-md) var(--space-sm);
}
.explore-ic {
  font-size: 48rpx;
  line-height: 1;
  color: var(--gold-a40);                /* 品牌装饰金 */
  margin-bottom: var(--space-sm);
}
.explore-title {
  font-size: var(--fs-body);             /* 28rpx Body */
  color: var(--text-main);
}
.explore-hover { border: 1rpx solid var(--gold-a20); }

/* —— ⑤ 热门角色（横向滚动） —— */
.char-scroll {
  width: 100%;
  white-space: nowrap;
}
.char-row {
  display: flex;
  flex-wrap: nowrap;
}
.char-card {
  flex-shrink: 0;
  width: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 20rpx;
  margin-right: var(--space-sm);
}
.char-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-title);
  font-weight: 700;
  color: rgba(255,255,255,0.6);
  margin-bottom: var(--space-sm);
}
.char-name {
  font-size: var(--fs-body);             /* 28rpx */
  color: var(--text-main);
  font-weight: 500;
}
.char-count {
  font-size: var(--fs-mini);             /* 20rpx */
  color: var(--text-weak);
  margin-top: var(--space-xs);
}
.char-story {
  font-size: var(--fs-mini);             /* 20rpx */
  color: var(--gold);
  font-weight: 500;
  margin-top: var(--space-xs);
}
.char-hover { border: 1rpx solid var(--gold-a20); }

/* —— ⑥ 最近观看（横向滚动） —— */
.recent-scroll {
  width: 100%;
  white-space: nowrap;
}
.recent-row {
  display: flex;
  flex-wrap: nowrap;
}
.recent-item {
  flex-shrink: 0;
  width: 120rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: var(--space-sm);
}
.recent-poster {
  width: 120rpx;
  height: 160rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-text {
  font-size: var(--fs-display);          /* 48rpx */
  font-weight: 700;
  color: rgba(255,255,255,0.5);
}
.recent-name {
  font-size: var(--fs-mini);             /* 20rpx */
  color: var(--text-sub);
  margin-top: var(--space-xs);
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recent-hover { opacity: 0.85; }

.empty-hint {
  font-size: var(--fs-body);             /* 28rpx */
  color: var(--text-weak);
  padding: var(--space-xl) 0;
  text-align: center;
}

/* —— 海报/头像阶段色（消费全局 phase token，仅内容标识） —— */
.poster-p1 { background: linear-gradient(135deg, var(--p1), var(--p1-a60)); }
.poster-p2 { background: linear-gradient(135deg, var(--p2), var(--p2-a60)); }
.poster-p3 { background: linear-gradient(135deg, var(--p3), var(--p3-a60)); }
.poster-p4 { background: linear-gradient(135deg, var(--p4), var(--p4-a60)); }
.poster-p5 { background: linear-gradient(135deg, var(--p5), var(--p5-a60)); }
.poster-p6 { background: linear-gradient(135deg, var(--p6), var(--p6-a60)); }
