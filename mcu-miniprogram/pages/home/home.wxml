<!-- 首页 home（Tab1）· V1.2 重构（严格按《V1.2 UI Design System》+《首页重设计方案》）
     固定结构（自上而下，禁止删除模块）：
       ① 品牌入口 → ② 继续观看(Hero) → ③ 我的路线(Content)
       → ④ 宇宙探索(三卡) → ⑤ 热门角色(横滚) → ⑥ 最近观看(横滚)
     约束：不新增功能 / 不改数据结构 / 不改跳转逻辑 / 不自行设计（按规范执行）
     双态：仅「继续观看」内容随 hasProgress 变化
       - 新人：从钢铁侠开始 / Phase 1 / 开始观看
       - 老用户：当前观看进度 / 下一部电影 / 继续观看
     图标：品牌盾牌 + 探索入口暂用 Unicode 占位（设计系统 §5.2.3 允许），待设计提供 SVG 替换 -->
<view class="mcu-page home-page">

  <!-- ═══ ① 品牌入口 ═══ -->
  <view class="brand-area">
    <view class="brand-mark"></view>
    <view class="brand-text">
      <view class="brand-title">MCU观影导航</view>
      <view class="brand-sub">你的漫威宇宙旅程</view>
    </view>
  </view>

  <!-- ═══ ② 继续观看（Hero Card，全页唯一焦点） ═══ -->
  <view class="card-hero continue-card">
    <view class="card-title">继续观看</view>
    <view class="continue-body">
      <view class="continue-meta">
        <view class="movie-name">{{continueCard.mainText}}</view>
        <view class="movie-phase">{{continueCard.phaseText}}</view>
        <view wx:if="{{continueCard.progressLabel}}" class="movie-progress-label">{{continueCard.progressLabel}}</view>
        <view wx:if="{{continueCard.progressText}}" class="movie-progress">{{continueCard.progressText}}</view>
      </view>
      <view class="btn-accent" data-id="{{continueCard.movieId}}" bindtap="goContinue" hover-class="btn-hover" hover-stay-time="80">{{continueCard.buttonText}}</view>
    </view>
  </view>

  <!-- ═══ ③ 我的路线（Content Card，Ghost 按钮） ═══ -->
  <view class="card-content my-route">
    <view class="card-title">我的路线</view>
    <view class="route-body">
      <view class="route-info">
        <view class="route-name">{{myRoute.name}}</view>
        <view class="route-progress">{{myRoute.progressText}}</view>
      </view>
      <view class="route-next">
        <view class="next-label">下一部推荐</view>
        <view class="next-name">{{myRoute.nextName}}</view>
      </view>
    </view>
    <view wx:if="{{myRoute.nextId}}" class="btn-ghost" data-id="{{myRoute.nextId}}" bindtap="goMovie" hover-class="btn-hover" hover-stay-time="80">继续路线</view>
    <view wx:else class="route-done">已完成当前路线</view>
  </view>

  <!-- ═══ ④ 宇宙探索入口（三卡横向等分，仅图标+名称） ═══ -->
  <view class="section">
    <view class="module-title">宇宙探索</view>
    <view class="explore-row">
      <view class="explore-card card-compact" wx:for="{{exploreEntries}}" wx:key="key" data-key="{{item.key}}" bindtap="goExplore" hover-class="explore-hover" hover-stay-time="80">
        <view class="explore-ic">{{item.glyph}}</view>
        <view class="explore-title">{{item.title}}</view>
      </view>
    </view>
  </view>

  <!-- ═══ ⑤ 热门角色（横向滚动故事入口） ═══ -->
  <view class="section">
    <view class="module-title">热门角色</view>
    <scroll-view class="char-scroll" scroll-x enable-flex>
      <view class="char-row">
        <view class="char-card card-compact" wx:for="{{hotChars}}" wx:key="id" data-id="{{item.id}}" bindtap="goChar" hover-class="char-hover" hover-stay-time="80">
          <view class="char-avatar poster-p{{item.phase}}">{{item.initial}}</view>
          <view class="char-name">{{item.name}}</view>
          <view class="char-count">关联 {{item.count}} 部作品</view>
          <view class="char-story">查看故事线</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ═══ ⑥ 最近观看（横向滚动） ═══ -->
  <view class="section">
    <view class="module-title">最近观看</view>
    <scroll-view wx:if="{{recent.length}}" class="recent-scroll" scroll-x enable-flex>
      <view class="recent-row">
        <view class="recent-item" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="goMovie" hover-class="recent-hover" hover-stay-time="80">
          <view class="recent-poster poster-p{{item.phase}}">
            <text class="poster-text">{{item.initial}}</text>
          </view>
          <view class="recent-name">{{item.name}}</view>
        </view>
      </view>
    </scroll-view>
    <view wx:else class="empty-hint">还没有观看记录，从《钢铁侠》开始你的旅程</view>
  </view>

</view>
