<!-- 首页 home（Tab1）· V1.2 重构（严格按《V1.2 UI Design System》）
     固定结构（自上而下，禁止删除模块）：
       ① 顶部品牌区 → ② 继续观看卡 → ③ 快捷入口 → ④ 新手路线推荐 → ⑤ 热门角色 → ⑥ 最近观看 → Tab
     约束：不新增功能 / 不改数据结构 / 不改跳转逻辑 / 不自行设计（按规范执行）
     双态：仅「继续观看卡」内容随 hasProgress 变化（新用户=开始观看 / 老用户=继续观看），其余模块常驻 -->
<view class="mcu-page home-page">

  <!-- ═══ ① 顶部品牌区 ═══ -->
  <view class="brand-area">
    <view class="brand-mark"></view>
    <view class="brand-text">
      <view class="brand-title">MCU观影导航</view>
      <view class="brand-sub">找到属于你的漫威观影路线</view>
    </view>
  </view>

  <!-- ═══ ② 继续观看卡 ═══ -->
  <view class="card continue-card">
    <view class="card-title">继续观看</view>
    <view class="continue-body">
      <view class="continue-meta">
        <view class="movie-name">{{continueCard.movieName}}</view>
        <view class="movie-phase">{{continueCard.phaseText}}</view>
        <view class="movie-progress">{{continueCard.progressText}}</view>
      </view>
      <view class="btn-accent" data-id="{{continueCard.movieId}}" bindtap="goContinue" hover-class="btn-hover" hover-stay-time="80">{{continueCard.buttonText}}</view>
    </view>
  </view>

  <!-- ═══ ③ 三个快捷入口 ═══ -->
  <view class="quick-row">
    <view class="quick-card" wx:for="{{quickEntries}}" wx:key="key" data-key="{{item.key}}" bindtap="goTab" hover-class="quick-hover" hover-stay-time="80">
      <image class="quick-ic" src="{{item.icon}}" mode="aspectFit"/>
      <view class="quick-title">{{item.title}}</view>
    </view>
  </view>

  <!-- ═══ ④ 新手路线推荐 ═══ -->
  <view class="card route-rec">
    <view class="route-rec-info">
      <view class="card-title">新手路线推荐</view>
      <view class="route-rec-sub">{{routeRec.name}} · 共 {{routeRec.count}} 部</view>
    </view>
    <view class="btn-accent btn-sm" data-key="route" bindtap="goTab" hover-class="btn-hover" hover-stay-time="80">{{routeRec.buttonText}}</view>
  </view>

  <!-- ═══ ⑤ 热门角色 ═══ -->
  <view class="section">
    <view class="module-title">热门角色</view>
    <view class="char-row">
      <view class="char-card" wx:for="{{hotChars}}" wx:key="id">
        <view class="char-avatar poster-p{{item.phase}}">{{item.initial}}</view>
        <view class="char-name">{{item.name}}</view>
        <view class="char-count">关联 {{item.count}} 部作品</view>
      </view>
    </view>
  </view>

  <!-- ═══ ⑥ 最近观看 ═══ -->
  <view class="section">
    <view class="module-title">最近观看</view>
    <view wx:if="{{recent.length}}" class="recent-row">
      <view class="recent-item" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="goMovie" hover-class="recent-hover" hover-stay-time="80">
        <view class="recent-poster poster-p{{item.phase}}">
          <text class="poster-text">{{item.initial}}</text>
        </view>
        <view class="recent-name">{{item.name}}</view>
      </view>
    </view>
    <view wx:else class="empty-hint">还没有观看记录，从《钢铁侠》开始你的旅程</view>
  </view>

  <view class="spacer-lg"></view>
</view>
