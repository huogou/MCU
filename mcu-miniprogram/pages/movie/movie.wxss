/* 电影详情 movie 样式 · V1.2 统一视觉
 * 颜色全部引用 app.wxss 全局 Token（零 raw hex 泄漏）
 * 图标：纯 CSS 绘制（ico / chevron），不引入 emoji 与第三方图标库
 */

.movie-page {
  padding: 0;
}

/* 海报阶段色兜底 */
.poster-p1 { background: linear-gradient(135deg, var(--p1), var(--p1-a60)); }
.poster-p2 { background: linear-gradient(135deg, var(--p2), var(--p2-a60)); }
.poster-p3 { background: linear-gradient(135deg, var(--p3), var(--p3-a60)); }
.poster-p4 { background: linear-gradient(135deg, var(--p4), var(--p4-a60)); }
.poster-p5 { background: linear-gradient(135deg, var(--p5), var(--p5-a60)); }
.poster-p6 { background: linear-gradient(135deg, var(--p6), var(--p6-a60)); }

/* ══════ 导航栏 ══════ */
.movie-nav-bar {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: 20rpx var(--page-x) 12rpx;
}
.back-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.nav-label {
  font-size: var(--fs-body);
  color: var(--text-sub);
}

/* ══════ ① Hero 区 ══════ */
.movie-hero {
  position: relative;
  padding: var(--space-lg) var(--page-x) var(--space-xl);
  display: flex;
  gap: var(--space-lg);
}
.hero-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.poster {
  width: 220rpx;
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 4rpx solid var(--gold-a20);
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
.poster-img { width: 100%; height: 100%; }
.poster-fill {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-letter {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--white-a50);
  text-align: center;
  line-height: 1.1;
}
.hero-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  z-index: 1;
  min-width: 0;
}
.hero-phase {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.hero-phase-dot {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
}
.hero-phase-text {
  font-size: var(--fs-mini);
  color: var(--text-weak);
}
.hero-title {
  font-size: var(--fs-display-sm);
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.3;
  margin-bottom: var(--space-xs);
}
.hero-en {
  font-size: var(--fs-caption);
  color: var(--text-weak);
  margin-bottom: var(--space-sm);
}
.hero-chips {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}
.chip {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--surface-3);
  font-size: var(--fs-mini);
  color: var(--text-weak);
}
.chip.gold { color: var(--gold); border-color: var(--gold-a20); background: var(--gold-a06); }
.chip.red { color: var(--p5); border-color: var(--p5-a20); background: var(--p5-a06); }
.chip.blue { color: var(--p1); border-color: var(--p1-a20); background: var(--p1-a06); }

/* 状态标签 */
.watch-status {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs);
  padding: var(--space-xs) 20rpx;
  border-radius: 999rpx;
  font-size: var(--fs-mini);
  font-weight: 600;
  margin-top: var(--space-sm);
  align-self: flex-start;
}
.watch-status.unwatched {
  background: var(--gold-a10);
  color: var(--gold);
  border: 2rpx solid var(--gold-a20);
}
.watch-status.watching {
  background: var(--success-a10);
  color: var(--success);
  border: 2rpx solid var(--success-a20);
}
.watch-status.watched {
  background: var(--surface-3);
  color: var(--text-weak);
  border: 2rpx solid var(--surface-3);
}

/* ══════ ② 主 CTA 区 ══════ */
.movie-cta-section {
  padding: 0 var(--page-x);
  margin-bottom: var(--space-md);
}
.movie-cta {
  width: 100%;
  padding: var(--space-md) 0;
  font-size: var(--fs-title);
  font-weight: 700;
  border: none;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  box-sizing: border-box;
}
.movie-cta.primary { background: var(--gold); color: var(--gold-btn-text); }
.movie-cta.done {
  background: var(--surface-3);
  color: var(--text-weak);
  border: 2rpx solid var(--surface-3);
}

/* ══════ ③ 观看资源模块 ══════ */
.resource-module {
  margin: 0 var(--page-x) var(--space-lg);
  background: var(--surface-2);
  border: 2rpx solid var(--surface-3);
  border-radius: 16rpx;
  overflow: hidden;
}
.resource-header {
  padding: var(--space-md);
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.resource-icon {
  width: 64rpx;
  height: 64rpx;
  background: var(--gold-a10);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--gold);
}
.resource-info { flex: 1; min-width: 0; }
.resource-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 6rpx;
}
.resource-sub {
  font-size: var(--fs-mini);
  color: var(--text-weak);
}
.resource-arrow {
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid var(--text-weak);
  border-bottom: 3rpx solid var(--text-weak);
  transform: rotate(45deg);
  transition: transform 0.2s;
  flex-shrink: 0;
}
.resource-module.expanded .resource-arrow {
  transform: rotate(225deg);
}
.resource-body {
  display: none;
  padding: 0 var(--space-md) var(--space-md);
  border-top: 2rpx solid var(--surface-3);
  margin: 0 var(--space-md);
  padding-top: var(--space-md);
}
.resource-module.expanded .resource-body {
  display: block;
}
.resource-pending {
  font-size: var(--fs-mini);
  color: var(--text-weak);
  opacity: 0.7;
}
.resource-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
}
.ri-label {
  flex: 1;
  font-size: var(--fs-caption);
  color: var(--text-sub);
}
.ri-btn {
  padding: 12rpx 28rpx;
  background: var(--gold-a10);
  color: var(--gold);
  font-size: var(--fs-caption);
  font-weight: 600;
  border: 2rpx solid var(--gold-a15);
  border-radius: var(--space-xs);
}

/* ══════ ④ 为什么现在看 ══════ */
.why-section {
  margin: 0 var(--page-x) var(--space-lg);
  background: var(--surface-2);
  border: 2rpx solid var(--surface-3);
  border-radius: 16rpx;
  padding: var(--space-md);
}
.why-label {
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--gold);
  margin-bottom: 12rpx;
}
.why-ctx {
  font-size: var(--fs-mini);
  color: var(--gold);
  margin-bottom: 10rpx;
  line-height: 1.5;
}
.why-text {
  font-size: var(--fs-body);
  color: var(--text-sub);
  line-height: 1.7;
}

/* ══════ ⑤ 前后关联 ══════ */
.sequence-section {
  padding: 0 var(--page-x);
  margin-bottom: var(--space-lg);
}
.sequence-label {
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--text-weak);
  margin-bottom: 20rpx;
}
.sequence-row {
  display: flex;
  gap: var(--space-sm);
  align-items: stretch;
}
.seq-card {
  flex: 1;
  background: var(--surface-2);
  border: 2rpx solid var(--surface-3);
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.seq-card.current {
  background: var(--gold-a10);
  border-color: var(--gold-a50);
}
.seq-card.seq-placeholder {
  justify-content: center;
}
.seq-poster {
  width: 80rpx;
  height: 116rpx;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.seq-poster text {
  font-size: var(--fs-body);
  font-weight: 800;
  color: var(--white-a50);
}
.seq-name {
  font-size: var(--fs-mini);
  color: var(--text-sub);
  line-height: 1.3;
}
.seq-card.current .seq-name {
  color: var(--gold);
  font-weight: 600;
}
.seq-role {
  font-size: var(--fs-mini);
  color: var(--text-weak);
}
.seq-arrow {
  display: flex;
  align-items: center;
  color: var(--text-weak);
  flex-shrink: 0;
}

/* ══════ ⑥ 看完之后 ══════ */
.after-section {
  margin: 0 var(--page-x) var(--space-xl);
}
.mark-watched-btn {
  width: 100%;
  padding: var(--space-md) 0;
  font-size: var(--fs-body);
  font-weight: 600;
  background: var(--surface-2);
  color: var(--success);
  border: 2rpx solid var(--success-a20);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  margin-bottom: var(--space-md);
}
.mark-watched-btn.marked {
  background: var(--success-a08);
  border-color: var(--success-a30);
  color: var(--success);
}
.next-rec {
  background: var(--surface-2);
  border: 2rpx solid var(--surface-3);
  border-radius: 16rpx;
  padding: var(--space-md);
  display: flex;
  gap: var(--space-md);
}
.next-rec-poster {
  width: 100rpx;
  height: 144rpx;
  border-radius: var(--space-xs);
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.next-rec-poster text {
  font-size: var(--fs-title);
  font-weight: 800;
  color: var(--white-a50);
}
.next-rec-info {
  flex: 1;
  min-width: 0;
}
.next-rec-label {
  font-size: var(--fs-mini);
  color: var(--gold);
  font-weight: 600;
  margin-bottom: var(--space-xs);
}
.next-rec-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 6rpx;
}
.next-rec-desc {
  font-size: var(--fs-caption);
  color: var(--text-sub);
  line-height: 1.4;
}
.next-rec-arrow {
  display: flex;
  align-items: center;
  color: var(--text-weak);
  flex-shrink: 0;
}

/* ══════ 未找到 ══════ */
.movie-empty {
  padding: 160rpx var(--page-x);
  text-align: center;
}
.movie-empty-title {
  font-size: var(--fs-title);
  color: var(--text-main);
  margin-bottom: 12rpx;
}
.movie-empty-sub {
  font-size: var(--fs-caption);
  color: var(--text-weak);
}

/* ══════ CSS 图标 ══════ */
.ico {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.ico-circle {
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}
.ico-play {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 14rpx 0 14rpx 24rpx;
  border-color: transparent transparent transparent currentColor;
}
.ico-check {
  width: 14rpx;
  height: 16rpx;
  position: relative;
}
.ico-check::after {
  content: '';
  position: absolute;
  left: 1rpx;
  top: 1rpx;
  width: 6rpx;
  height: 11rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg);
}
.chevron-left {
  width: 16rpx;
  height: 16rpx;
  border-left: 3rpx solid var(--text-sub);
  border-bottom: 3rpx solid var(--text-sub);
  transform: rotate(45deg);
}
.chevron-right {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(-45deg);
}

/* ══════ 成就解锁弹窗 ══════ */
.ach-mask {
  position: fixed;
  inset: 0;
  background: var(--bg-a70);
  z-index: 99;
  display: flex;
  align-items: flex-end;
}
.ach-sheet {
  width: 100%;
  background: var(--surface-1);
  border-radius: 32rpx 32rpx 0 0;
  padding: 56rpx 48rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.ach-close {
  position: absolute;
  top: 28rpx;
  right: var(--space-lg);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ach-close-x {
  width: 24rpx;
  height: 24rpx;
  position: relative;
}
.ach-close-x::before,
.ach-close-x::after {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 100%;
  height: 3rpx;
  background: var(--text-weak);
  border-radius: 2rpx;
}
.ach-close-x::before { transform: rotate(45deg); }
.ach-close-x::after { transform: rotate(-45deg); }
.ach-sheet-badge {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  background: var(--gold-a14);
  border: 3rpx solid var(--gold-a55);
  color: var(--gold);
  font-size: 60rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}
.ach-sheet-title {
  font-size: var(--fs-caption);
  color: var(--text-weak);
  letter-spacing: 0.06em;
  margin-bottom: 12rpx;
}
.ach-sheet-name {
  font-size: var(--fs-display-sm);
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 12rpx;
}
.ach-sheet-desc {
  font-size: var(--fs-body);
  color: var(--text-sub);
  margin-bottom: 44rpx;
  text-align: center;
  line-height: 1.5;
}
.ach-sheet-actions {
  width: 100%;
  display: flex;
  gap: 20rpx;
}
.ach-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: var(--fs-body);
  font-weight: 600;
  border-radius: 44rpx;
  background: var(--surface-2);
  color: var(--text-main);
  border: 2rpx solid var(--surface-3);
}
.ach-btn.gold {
  background: var(--gold);
  color: var(--gold-btn-text);
  border: none;
}
