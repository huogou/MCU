/* MCU观影导航 V1.2-DS - 全局样式 / 设计 Token
 * 依据：《MCU-V1.2-开发视觉标注》§一/§二（设计 AI 唯一视觉标准）
 * V1.2 变更：字号/间距/圆角/阴影体系升级 + 功能四色 + surface-0
 * 禁止在页面层写死颜色，一律引用以下 CSS 变量（零 raw hex 泄漏）。
 */
page {
  /* ── 背景层 ── */
  --bg: #080B12;
  --surface-0: #0D1119;
  --surface-1: #161D2B;
  --surface-2: #1E2636;
  --surface-3: #2A3447;

  /* ── 品牌金 ── */
  --gold: #F2B233;

  /* ── 功能强调色（V1.2 新增） ── */
  --accent-blue: #4A9EF5;
  --accent-red: #E85D5D;
  --accent-purple: #9B7FE8;
  --accent-blue-a10: rgba(74,158,245,0.10);
  --accent-blue-a20: rgba(74,158,245,0.20);
  --accent-red-a10: rgba(232,93,93,0.10);
  --accent-red-a20: rgba(232,93,93,0.20);
  --accent-purple-a10: rgba(155,127,232,0.10);
  --accent-purple-a20: rgba(155,127,232,0.20);

  /* ── 六阶段色（仅用于内容标识，不参与 UI 框架） ── */
  --p1: #5B8DEF;
  --p2: #28B487;
  --p3: #F0A932;
  --p4: #8B6FE8;
  --p5: #E8483F;
  --p6: #C25B8E;

  /* ── 三级文本 ── */
  --text-main: #E8ECF4;
  --text-sub: #8E98AA;
  --text-weak: #555F73;

  /* ── 状态 ── */
  --success: #3FB98A;
  --error: #E5604D;

  /* ── 基础 ── */
  --white: #FFFFFF;
  --gold-btn-text: #1A1206;

  /* ── 字号体系（5级制，V1.2-DS 升级） ── */
  --fs-display: 56rpx;
  --fs-display-sm: 44rpx;
  --fs-title: 36rpx;
  --fs-body: 28rpx;
  --fs-caption: 24rpx;
  --fs-mini: 22rpx;

  /* ── 间距体系（V1.2-DS 升级） ── */
  --space-xs: 8rpx;
  --space-sm: 20rpx;
  --space-md: 28rpx;
  --space-lg: 36rpx;
  --space-xl: 56rpx;
  --space-2xl: 72rpx;
  --page-x: 36rpx;

  /* ── 圆角（5 级，V1.2 新增） ── */
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 20rpx;
  --radius-xl: 32rpx;
  --radius-full: 999rpx;

  /* ── 阴影（V1.2 新增） ── */
  --shadow-card: 0 4rpx 16rpx rgba(0,0,0,0.3);
  --shadow-hero: 0 8rpx 32rpx rgba(0,0,0,0.4);
  --glow-gold: 0 8rpx 24rpx rgba(242,178,51,0.12);
  --glow-gold-strong: 0 12rpx 40rpx rgba(242,178,51,0.20);

  /* ── 金色 alpha 变体（基准 rgb 242,178,51） ── */
  --gold-a02: rgba(242,178,51,0.02);
  --gold-a03: rgba(242,178,51,0.03);
  --gold-a04: rgba(242,178,51,0.04);
  --gold-a06: rgba(242,178,51,0.06);
  --gold-a08: rgba(242,178,51,0.08);
  --gold-a10: rgba(242,178,51,0.10);
  --gold-a12: rgba(242,178,51,0.12);
  --gold-a14: rgba(242,178,51,0.14);
  --gold-a15: rgba(242,178,51,0.15);
  --gold-a20: rgba(242,178,51,0.20);
  --gold-a40: rgba(242,178,51,0.40);
  --gold-a30: rgba(242,178,51,0.30);
  --gold-a50: rgba(242,178,51,0.50);
  --gold-a55: rgba(242,178,51,0.55);
  --gold-a60: rgba(242,178,51,0.60);

  /* ── 状态色 alpha ── */
  --success-a08: rgba(63,185,138,0.08);
  --success-a10: rgba(63,185,138,0.10);
  --success-a15: rgba(63,185,138,0.15);
  --success-a20: rgba(63,185,138,0.20);
  --success-a30: rgba(63,185,138,0.30);
  --error-a15: rgba(229,96,77,0.15);

  /* ── 白色 alpha ── */
  --white-a08: rgba(255,255,255,0.08);
  --white-a12: rgba(255,255,255,0.12);
  --white-a50: rgba(255,255,255,0.50);
  --white-a60: rgba(255,255,255,0.60);
  --white-a70: rgba(255,255,255,0.70);

  /* ── 背景 alpha ── */
  --bg-a55: rgba(8,11,18,0.55);
  --bg-a70: rgba(8,11,18,0.70);
  --black-a35: rgba(0,0,0,0.35);

  /* ── 阶段色 alpha ── */
  --p1-a60: rgba(91,141,239,0.60);
  --p2-a60: rgba(40,180,135,0.60);
  --p3-a60: rgba(240,169,50,0.60);
  --p4-a60: rgba(139,111,232,0.60);
  --p5-a60: rgba(232,72,63,0.60);
  --p6-a60: rgba(194,91,142,0.60);
  --p1-a06: rgba(91,141,239,0.06);
  --p5-a06: rgba(232,72,63,0.06);
  --p1-a20: rgba(91,141,239,0.20);
  --p5-a20: rgba(232,72,63,0.20);
  --p2-a15: rgba(40,180,135,0.15);
  --p4-a15: rgba(139,111,232,0.15);

  background: var(--bg);
  color: var(--text-main);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* —— V1.2-DS 通用布局类（全局可用，页面不重复定义） —— */
.mcu-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
  padding: 0 var(--page-x);
}

.mcu-section {
  margin-bottom: var(--space-xl);
}

/* 三级卡片体系（V1.2-DS：圆角 Hero32/Content20/Compact16 + 阴影） */
.mcu-card {
  background: var(--surface-1);
  border-radius: var(--radius-xl);
  padding: var(--space-lg);
  margin-bottom: var(--space-sm);
}
.card-hero {
  background: var(--surface-1);
  border-radius: var(--radius-xl);
  padding: var(--space-lg);
  box-shadow: var(--shadow-hero);
}
.card-content {
  background: var(--surface-2);
  border: 1rpx solid var(--surface-3);
  border-radius: var(--radius-lg);
  padding: var(--space-md);
  box-shadow: var(--shadow-card);
}
.card-compact {
  background: var(--surface-2);
  border-radius: var(--radius-md);
  padding: var(--space-sm) 20rpx;
}

/* 文字层级（V1.2-DS） */
.mcu-display {
  font-size: var(--fs-display);
  font-weight: 700;
  color: var(--text-main);
}
.mcu-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--text-main);
}
.mcu-body {
  font-size: var(--fs-body);
  color: var(--text-main);
}
.mcu-sub {
  font-size: var(--fs-body);
  color: var(--text-sub);
}
.mcu-caption {
  font-size: var(--fs-caption);
  color: var(--text-sub);
}
.mcu-weak {
  font-size: var(--fs-caption);
  color: var(--text-weak);
}
.mcu-mini {
  font-size: var(--fs-mini);
  color: var(--text-weak);
}
.mcu-gold {
  color: var(--gold);
}

/* 按钮（V1.2-DS） */
.mcu-btn-primary {
  background: var(--gold);
  color: var(--gold-btn-text);
  font-weight: 600;
  border-radius: var(--radius-md);
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  box-shadow: var(--glow-gold);
}
.mcu-btn-ghost {
  color: var(--gold);
  font-size: var(--fs-body);
  font-weight: 400;
}
.mcu-btn-gold {
  background: var(--gold);
  color: var(--gold-btn-text);
  font-weight: 600;
  border-radius: var(--radius-md);
  padding: 20rpx 0;
  text-align: center;
  box-shadow: var(--glow-gold);
}

.mcu-divider {
  height: 1rpx;
  background: var(--surface-3);
  margin: var(--space-lg) 0;
}
