<!-- 宇宙节点信息页 movie · V2.3 轻量化
     定位：MCU 宇宙节点查询/导航页（非影视详情页）
     V2.3 结构性删除：海报、英文片名、内容类型标签、观看状态、标记已看、收藏、上映日期
     结构：中文名称 + 阶段 / 宇宙节点信息 / 关联节点 / 进入宇宙导航 -->
<view class="mcu-page movie-page">

  <!-- ═══ id 缺失 / 节点不存在 ═══ -->
  <view wx:if="{{notFound}}" class="mv-empty">
    <view class="me-title">没有找到这个节点</view>
    <view class="me-desc">可能链接已失效，去作品索引重新查询</view>
    <view class="me-btn" bindtap="goLibrary" hover-class="btn-hover" hover-stay-time="80">去作品索引</view>
  </view>

  <block wx:else>

    <!-- ═══ 节点名称 + 阶段 ═══ -->
    <view class="mv-cn">{{cn}}</view>
    <view class="mv-pills">
      <text wx:if="{{phaseText}}" class="mv-pill mv-phase">{{phaseText}}</text>
    </view>

    <!-- ═══ 宇宙节点 ═══ -->
    <view class="section-label">宇宙节点</view>
    <view class="mv-info">
      <view class="mi-row" wx:for="{{infoRows}}" wx:key="k">
        <text class="mi-k">{{item.k}}</text>
        <text class="mi-v">{{item.v}}</text>
      </view>
    </view>

    <!-- ═══ 关联节点（仅名称 + 所属阶段，点击进入对应节点） ═══ -->
    <view wx:if="{{hasRelations}}" class="mv-block">
      <view class="section-label">关联节点 · {{relCount}}</view>
      <view class="rel-list">
        <view class="rel-item" wx:for="{{relations}}" wx:key="id"
              data-id="{{item.id}}" bindtap="goRelated"
              hover-class="rel-hover" hover-stay-time="60">
          <view class="rel-main">
            <view class="rel-name">{{item.cn}}</view>
            <view class="rel-phase">{{item.phaseLabel}}</view>
          </view>
          <text class="rel-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- ═══ 底部：进入宇宙导航 ═══ -->
    <view class="mv-nav-btn" bindtap="goJourney" hover-class="btn-hover" hover-stay-time="80">进入宇宙导航</view>

    <view class="mcu-bottom-space"></view>
  </block>
</view>
