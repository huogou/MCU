<!-- 作品节点页 movie · V2.0.0 降级为「作品节点」
     定位：观看路线中的作品节点（非影视详情页）
     V2.0 删除：作品简介、rel-why、backdrop、篇章、故事时间、篇幅
     核心视觉：观看状态 + 顺序位置
     海报仅用于识别（非影视宣传） -->
<view class="mcu-page movie-page">

  <!-- ═══ id 缺失 / 作品不存在 ═══ -->
  <view wx:if="{{notFound}}" class="mv-empty">
    <view class="me-title">没有找到这部作品</view>
    <view class="me-desc">可能链接已失效，去作品索引重新查询</view>
    <view class="me-btn" bindtap="goLibrary" hover-class="btn-hover" hover-stay-time="80">去作品索引</view>
  </view>

  <block wx:else>

    <!-- ═══ 核心视觉：顺序 + 名称（非海报 Hero） ═══ -->
    <view class="mv-order-row">
      <text class="mv-order">{{orderText}}</text>
    </view>
    <view class="mv-cn">{{cn}}</view>
    <view wx:if="{{en}}" class="mv-en">{{en}}</view>
    <view class="mv-pills">
      <text class="mv-pill mv-type-{{typeKey}}">{{typeLabel}}</text>
      <text class="mv-pill mv-phase">{{phaseText}}</text>
      <text wx:if="{{year}}" class="mv-year">· {{year}}</text>
    </view>

    <!-- ═══ 海报（识别用，非宣传） + 观看状态卡 ═══ -->
    <view class="mv-main-row">
      <!-- 海报：小尺寸，仅用于识别 -->
      <view class="mv-poster {{poster ? '' : 'poster-p' + phase}}">
        <image wx:if="{{poster}}" class="fill-img" src="{{poster}}" mode="aspectFill" lazy-load="true" />
        <text wx:else class="mv-letter">{{letter}}</text>
      </view>

      <!-- 观看状态 + 动作 -->
      <view class="mv-status-card">
        <view class="ms-top">
          <text class="ms-label">我的观看状态</text>
          <text class="ms-state {{watched ? 'is-done' : ''}}">{{watched ? '已看' : '未看'}}</text>
        </view>
        <view wx:if="{{seenAtText}}" class="ms-seen-at">{{seenAtText}}</view>
        <view class="ms-actions">
          <view class="ms-btn {{watched ? 'is-off' : 'is-primary'}}"
                bindtap="onToggleWatched" hover-class="btn-hover" hover-stay-time="80">{{watchedLabel}}</view>
          <view class="ms-btn {{favored ? 'is-faved' : 'is-ghost'}}"
                bindtap="onToggleFav" hover-class="btn-hover" hover-stay-time="80">{{favorLabel}}</view>
        </view>
      </view>
    </view>

    <!-- ═══ 作品信息表（V2.0 精简：无篇章/故事时间/篇幅） ═══ -->
    <view class="section-label">作品信息</view>
    <view class="mv-info">
      <view class="mi-row" wx:for="{{infoRows}}" wx:key="k">
        <text class="mi-k">{{item.k}}</text>
        <text class="mi-v">{{item.v}}</text>
      </view>
    </view>

    <!-- ═══ 相关作品（V2.0 删除 why，仅作品名+类型） ═══ -->
    <view wx:if="{{hasRelations}}" class="mv-block">
      <view class="section-label">相关作品 · {{relCount}} 条</view>
      <view class="rel-list">
        <view class="rel-item" wx:for="{{relations}}" wx:key="id"
              data-id="{{item.id}}" bindtap="goRelated"
              hover-class="rel-hover" hover-stay-time="60">
          <view class="rel-main">
            <view class="rel-name">{{item.cn}}<text wx:if="{{item.watched}}" class="rel-seen">已看</text></view>
          </view>
          <text class="rel-type rel-type-{{item.typeKey}}">{{item.typeLabel}}</text>
          <text class="rel-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- ═══ H5 引导 ═══ -->
    <h5-guide title="想了解更多？" desc="查看完整作品信息" />

    <view class="mcu-bottom-space"></view>
  </block>
</view>
