/* 作品详情 movie（轻量版）· 2026-09-08 重建
 * 纪律：颜色一律引用 app.wxss 变量，零 raw hex 泄漏
 */
.movie-page { padding-bottom: 0; }

.section-label {
  margin: var(--space-lg) 0 var(--space-sm);
  font-size: var(--fs-caption);
  color: var(--text-sub);
  font-weight: 600;
}

/* ── ① 作品标识 ── */
.mv-head {
  display: flex;
  align-items: flex-start;
  margin-top: var(--space-md);
}
.mv-poster {
  flex: none;
  width: 200rpx;
  height: 284rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  font-weight: 700;
  color: var(--white);
  box-shadow: var(--shadow-card);
}
.mv-head-info {
  flex: 1;
  min-width: 0;
  margin-left: var(--space-md);
}
.mv-cn {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.35;
}
.mv-en {
  margin-top: 4rpx;
  font-size: var(--fs-caption);
  color: var(--text-weak);
  line-height: 1.4;
}
.mv-pills {
  margin-top: var(--space-sm);
  display: flex;
  flex-wrap: wrap;
}
.mv-pill {
  margin: 0 var(--space-xs) var(--space-xs) 0;
  padding: 6rpx 18rpx;
  font-size: var(--fs-mini);
  border-radius: var(--radius-full);
}

/* ── ② 我的观看状态卡（页中最主要的交互区） ── */
.mv-status-card {
  margin-top: var(--space-lg);
  padding: var(--space-md);
  background: var(--surface-1);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
}
.ms-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ms-label {
  font-size: var(--fs-caption);
  color: var(--text-sub);
}
.ms-state {
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--text-weak);
  background: var(--surface-3);
  padding: 4rpx 18rpx;
  border-radius: var(--radius-full);
}
.ms-state.is-done {
  color: var(--success);
  background: var(--success-a15);
}
.ms-seen-at {
  margin-top: var(--space-xs);
  font-size: var(--fs-mini);
  color: var(--text-weak);
}
.ms-actions {
  display: flex;
  margin-top: var(--space-md);
}
.ms-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: var(--fs-body);
  font-weight: 600;
  border-radius: var(--radius-md);
}
.ms-btn + .ms-btn { margin-left: var(--space-sm); }
.ms-btn.is-primary {
  background: var(--gold);
  color: var(--gold-btn-text);
  box-shadow: var(--glow-gold);
}
.ms-btn.is-off {
  background: var(--surface-3);
  color: var(--text-sub);
}
.ms-btn.is-ghost {
  background: var(--gold-a10);
  color: var(--gold);
  border: 1rpx solid var(--gold-a40);
}
.ms-btn.is-faved {
  background: var(--success-a15);
  color: var(--success);
  border: 1rpx solid var(--success-a30);
}

/* ── ③ 信息表 ── */
.mv-info {
  background: var(--surface-1);
  border-radius: var(--radius-xl);
  padding: 0 var(--space-md);
}
.mi-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--surface-2);
}
.mi-row:last-child { border-bottom: none; }
.mi-k {
  font-size: var(--fs-caption);
  color: var(--text-weak);
}
.mi-v {
  font-size: var(--fs-caption);
  color: var(--text-main);
  text-align: right;
  max-width: 60%;
}

/* ── ④ 简介 ── */
.mv-block { margin-top: var(--space-sm); }
.mv-synopsis {
  padding: var(--space-md);
  background: var(--surface-1);
  border-radius: var(--radius-lg);
  font-size: var(--fs-body);
  color: var(--text-sub);
  line-height: 1.7;
}

/* ── ⑤ 相关作品 ── */
.rel-list {
  background: var(--surface-1);
  border-radius: var(--radius-xl);
  overflow: hidden;
}
.rel-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: var(--space-md);
  border-bottom: 1rpx solid var(--surface-2);
}
.rel-item:last-child { border-bottom: none; }
.rel-hover { background: var(--surface-2); }
.rel-main { flex: 1; min-width: 0; }
.rel-name {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-main);
}
.rel-seen {
  margin-left: var(--space-xs);
  padding: 2rpx 12rpx;
  font-size: var(--fs-mini);
  font-weight: 400;
  color: var(--success);
  background: var(--success-a15);
  border-radius: var(--radius-full);
}
.rel-why {
  margin-top: var(--space-xs);
  font-size: var(--fs-caption);
  color: var(--text-sub);
  line-height: 1.6;
}
.rel-type {
  flex: none;
  margin-left: var(--space-sm);
  padding: 4rpx 14rpx;
  font-size: var(--fs-mini);
  color: var(--text-weak);
  background: var(--surface-3);
  border-radius: var(--radius-full);
}

/* ── 兜底 ── */
.mv-empty {
  margin-top: 200rpx;
  text-align: center;
}
.me-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-main);
}
.me-desc {
  margin-top: var(--space-xs);
  font-size: var(--fs-caption);
  color: var(--text-sub);
}
.me-btn {
  display: inline-block;
  margin-top: var(--space-lg);
  padding: 16rpx 48rpx;
  font-size: var(--fs-caption);
  color: var(--gold);
  background: var(--gold-a10);
  border: 1rpx solid var(--gold-a40);
  border-radius: var(--radius-full);
}

.btn-hover { opacity: 0.7; }
.mcu-bottom-space { height: var(--space-xl); }
