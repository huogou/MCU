/* 宇宙节点信息页 movie · V2.3 轻量化
 * 纪律：颜色一律引用 app.wxss 变量，零 raw hex 泄漏
 * V2.3：删除海报/观看状态/类型标签相关样式；新增关联节点阶段、导航按钮
 */
.movie-page { padding-bottom: 0; }

.section-label {
  margin: var(--space-lg) 0 var(--space-sm);
  font-size: var(--fs-caption);
  color: var(--text-sub);
  font-weight: 600;
}

/* ── ① 节点名称 + 阶段 ── */
.mv-cn {
  margin-top: var(--space-md);
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.35;
}
.mv-pills {
  margin-top: var(--space-sm);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}
.mv-pill {
  margin: 0 var(--space-xs) var(--space-xs) 0;
  padding: 6rpx 18rpx;
  font-size: var(--fs-mini);
  border-radius: var(--radius-full);
}

/* ── ② 信息表 ── */
.mv-info {
  background: var(--surface-1);
  border-radius: var(--radius-xl);
  padding: 0 var(--space-md);
}
.mi-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) 0;
  border-bottom: 1rpx solid var(--surface-2);
}
.mi-row:last-child { border-bottom: none; }
.mi-k {
  font-size: var(--fs-caption);
  color: var(--text-weak);
}
.mi-v {
  font-size: var(--fs-caption);
  color: var(--text-main);
  text-align: right;
  max-width: 60%;
}

/* ── ③ 关联节点 ── */
.mv-block { margin-top: var(--space-sm); }
.rel-list {
  background: var(--surface-1);
  border-radius: var(--radius-xl);
  overflow: hidden;
}
.rel-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md);
  border-bottom: 1rpx solid var(--surface-2);
}
.rel-item:last-child { border-bottom: none; }
.rel-hover { background: var(--surface-2); }
.rel-main { flex: 1; min-width: 0; }
.rel-name {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-main);
}
.rel-phase {
  margin-top: 4rpx;
  font-size: var(--fs-mini);
  color: var(--text-weak);
}
.rel-arrow {
  flex: none;
  margin-left: var(--space-sm);
  font-size: var(--fs-body);
  color: var(--text-weak);
}

/* ── ④ 底部：进入宇宙导航 ── */
.mv-nav-btn {
  margin-top: var(--space-lg);
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: var(--fs-body);
  font-weight: 600;
  background: var(--gold);
  color: var(--gold-btn-text);
  border-radius: var(--radius-md);
  box-shadow: var(--glow-gold);
}

/* ── 兜底 ── */
.mv-empty {
  margin-top: 200rpx;
  text-align: center;
}
.me-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-main);
}
.me-desc {
  margin-top: var(--space-xs);
  font-size: var(--fs-caption);
  color: var(--text-sub);
}
.me-btn {
  display: inline-block;
  margin-top: var(--space-lg);
  padding: 16rpx 48rpx;
  font-size: var(--fs-caption);
  color: var(--gold);
  background: var(--gold-a10);
  border: 1rpx solid var(--gold-a40);
  border-radius: var(--radius-full);
}

.btn-hover { opacity: 0.7; }
.mcu-bottom-space { height: var(--space-xl); }
