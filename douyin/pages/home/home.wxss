/* 首页 home（Tab1）· V2.0.0 轻量版重构
 * 结构：① 进度Hero → ② 核心入口2×2 → ③ 下一步 → ④ 最近标记 → ⑤ H5引导
 * 纪律：颜色一律引用 app.wxss 变量（零 raw hex 泄漏） */
.home-page {
  padding: 0 var(--page-x);
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
  padding-bottom: var(--space-2xl);
  padding-top: var(--space-md);
}

/* 模块标题 */
.section-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--text-main);
  margin-top: var(--space-xl);
  margin-bottom: var(--space-sm);
}

/* ═══ ① 进度 Hero（数据型，非影视背景图） ═══ */
.progress-hero {
  background: var(--surface-1);
  border: 1rpx solid var(--gold-a30);
  border-radius: var(--radius-xl);
  padding: var(--space-lg);
  box-shadow: var(--glow-gold);
}
.ph-tag {
  font-size: var(--fs-mini);
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 4rpx;
}
.ph-title {
  font-size: var(--fs-display);
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.2;
  margin-top: var(--space-xs);
}
.ph-sub {
  font-size: var(--fs-caption);
  color: var(--text-sub);
  margin-top: var(--space-xs);
}
.ph-bar {
  height: 8rpx;
  background: var(--surface-3);
  border-radius: var(--radius-full);
  margin-top: var(--space-md);
  overflow: hidden;
}
.ph-fill {
  height: 100%;
  background: var(--gold);
  border-radius: var(--radius-full);
  transition: width 0.3s;
}
.ph-cta {
  font-size: var(--fs-mini);
  color: var(--gold);
  font-weight: 600;
  margin-top: var(--space-sm);
}

/* ═══ ② 核心入口 2×2 ═══ */
.entry-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}
.entry-card {
  width: calc((100% - var(--space-sm)) / 2);
  box-sizing: border-box;
  background: var(--surface-1);
  border: 1rpx solid var(--surface-3);
  border-radius: var(--radius-lg);
  padding: var(--space-md);
  min-height: 160rpx;
}
.entry-card.is-disabled { opacity: 0.5; }

.ec-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: var(--space-sm);
}
.ec-gold .ec-icon { background: var(--gold-a15); color: var(--gold); }
.ec-green .ec-icon { background: var(--success-a15); color: var(--success); }
.ec-blue .ec-icon { background: var(--accent-blue-a20); color: var(--accent-blue); }
.ec-orange .ec-icon { background: var(--gold-a15); color: var(--gold); }

.ec-orange { border-color: var(--gold-a20); border-style: dashed; }

.ec-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--text-main);
}
.ec-desc {
  font-size: var(--fs-mini);
  color: var(--text-sub);
  margin-top: 2rpx;
}
.ec-orange .ec-desc { color: var(--gold); }

/* ═══ ③ 下一步建议 ═══ */
.next-card {
  display: flex;
  align-items: center;
  background: var(--surface-1);
  border: 1rpx solid var(--surface-3);
  border-radius: var(--radius-lg);
  padding: var(--space-sm);
}
.nc-poster {
  flex-shrink: 0;
  width: 96rpx;
  height: 128rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nc-initial {
  font-size: var(--fs-display-sm);
  font-weight: 700;
  color: var(--white-a50);
}
.nc-info {
  flex: 1;
  min-width: 0;
  margin: 0 var(--space-sm);
}
.nc-order {
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--gold);
}
.nc-name {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-main);
  margin-top: 2rpx;
}
.nc-meta {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}
.nc-type {
  font-size: var(--fs-mini);
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full);
  margin-right: var(--space-xs);
}
.nc-type-movie, .nc-type-series { background: var(--accent-blue-a10); color: var(--accent-blue); }
.nc-type-special, .nc-type-short { background: var(--accent-purple-a10); color: var(--accent-purple); }
.nc-phase {
  font-size: var(--fs-mini);
  color: var(--text-weak);
}
.nc-badge {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  font-size: var(--fs-mini);
  border-radius: var(--radius-full);
}
.nc-badge.done { color: var(--success); background: var(--success-a15); }
.nc-badge.todo { color: var(--text-weak); background: var(--surface-3); }

/* ═══ ④ 最近标记 ═══ */
.recent-scroll {
  width: 100%;
  white-space: nowrap;
}
.recent-row {
  display: flex;
  flex-wrap: nowrap;
}
.recent-item {
  flex-shrink: 0;
  width: 120rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: var(--space-sm);
}
.recent-poster {
  width: 120rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-text {
  font-size: var(--fs-display);
  font-weight: 700;
  color: var(--white-a50);
}
.recent-name {
  font-size: var(--fs-caption);
  color: var(--text-sub);
  margin-top: var(--space-xs);
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recent-hover { opacity: 0.85; }

.empty-hint {
  font-size: var(--fs-body);
  color: var(--text-weak);
  padding: var(--space-xl) 0;
  text-align: center;
}

/* ═══ 通用 ═══ */
.btn-hover { opacity: 0.85; }
.fill-img { width: 100%; height: 100%; display: block; }
.mcu-bottom-space { height: var(--space-xl); }
