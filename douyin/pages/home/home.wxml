<!-- 首页 home（Tab1）· V2.0.0 轻量版重构
     结构（5 层）：
     ① 进度 Hero（数据型，非影视背景图）
     ② 核心入口 2×2（首次/继续/路线/宇宙关系→H5）
     ③ 下一步建议（仅顺序逻辑，无剧情推荐理由）
     ④ 最近标记（横滚，工具属性）
     ⑤ H5 引导（工具型引导卡，非影视推广 Banner）
     合规：无剧情推荐、无影视资讯、无角色内容、无评分票房、无播放入口 -->
<view class="mcu-page home-page">

  <!-- ═══ ① 进度 Hero（数据型，非影视背景图） ═══ -->
  <view class="progress-hero" bindtap="goJourney" hover-class="btn-hover" hover-stay-time="80">
    <view class="ph-tag">我的观看进度</view>
    <view class="ph-title">MCU 旅程</view>
    <view class="ph-sub">{{hasProgress ? '已完成 ' + progressCount + ' / ' + progressTotal + ' 部 · ' + phaseText : '已完成 0 / ' + progressTotal + ' 部 · 尚未开始'}}</view>
    <view class="ph-bar">
      <view class="ph-fill" style="width:{{progressPercent}}%;"></view>
    </view>
    <view class="ph-cta">查看路线 ›</view>
  </view>

  <!-- ═══ ② 核心入口 2×2 ═══ -->
  <view class="section-title">快速开始</view>
  <view class="entry-grid">
    <view class="entry-card ec-{{item.iconColor}} {{item.action === 'none' ? 'is-disabled' : ''}}"
          wx:for="{{entries}}" wx:key="key"
          data-key="{{item.key}}" bindtap="onEntry"
          hover-class="btn-hover" hover-stay-time="80">
      <view class="ec-icon">{{item.icon}}</view>
      <view class="ec-title">{{item.title}}</view>
      <view class="ec-desc">{{item.desc}}</view>
    </view>
  </view>

  <!-- ═══ ③ 下一步建议（仅顺序逻辑，无推荐理由） ═══ -->
  <block wx:if="{{nextStep}}">
    <view class="section-title">下一步</view>
    <view class="next-card" data-id="{{nextStep.id}}" bindtap="goDetail"
          hover-class="btn-hover" hover-stay-time="80">
      <view class="nc-poster poster-p{{nextStep.phase}}">
        <image wx:if="{{nextStep.poster}}" class="fill-img" src="{{nextStep.poster}}" mode="aspectFill" lazy-load="true"/>
        <text wx:else class="nc-initial">{{nextStep.initial}}</text>
      </view>
      <view class="nc-info">
        <view class="nc-order">{{nextStep.order}}</view>
        <view class="nc-name">{{nextStep.name}}</view>
        <view class="nc-meta">
          <text class="nc-type nc-type-{{nextStep.typeKey}}">{{nextStep.typeLabel}}</text>
          <text class="nc-phase">{{nextStep.phaseText}}</text>
        </view>
      </view>
      <view class="nc-badge {{nextStep.watched ? 'done' : 'todo'}}">{{nextStep.watched ? '已看' : '未看'}}</view>
    </view>
  </block>

  <!-- ═══ ④ 最近标记（横滚） ═══ -->
  <view class="section-title">最近标记</view>
  <scroll-view wx:if="{{recent.length}}" class="recent-scroll" scroll-x enable-flex>
    <view class="recent-row">
      <view class="recent-item" wx:for="{{recent}}" wx:key="id"
            data-id="{{item.id}}" bindtap="goDetail"
            hover-class="recent-hover" hover-stay-time="80">
        <view class="recent-poster poster-p{{item.phase}}">
          <image wx:if="{{item.poster}}" class="fill-img" src="{{item.poster}}" mode="aspectFill" lazy-load="true"/>
          <text wx:else class="poster-text">{{item.initial}}</text>
        </view>
        <view class="recent-name">{{item.name}}</view>
      </view>
    </view>
  </scroll-view>
  <view wx:else class="empty-hint">还没有已标记的作品，从《钢铁侠》开始你的旅程</view>



  <view class="mcu-bottom-space"></view>
</view>
