/* 作品查询 library（Tab2）· 2026-09-08 新增
 * 纪律：颜色一律引用 app.wxss 变量（零 raw hex 泄漏），与设计 Token 体系一致
 */
.lib-page {
  padding-bottom: 0;
}

/* ── ① 搜索框 ── */
.lib-search {
  display: flex;
  align-items: center;
  height: 80rpx;
  margin: var(--space-md) 0 var(--space-sm);
  padding: 0 var(--space-md);
  background: var(--surface-1);
  border: 1rpx solid var(--surface-3);
  border-radius: var(--radius-full);
}
.ls-icon {
  font-size: 32rpx;
  color: var(--text-weak);
  margin-right: var(--space-xs);
}
.ls-input {
  flex: 1;
  height: 80rpx;
  font-size: var(--fs-body);
  color: var(--text-main);
}
.ls-ph { color: var(--text-weak); }
.ls-clear {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: var(--radius-full);
  color: var(--text-sub);
  background: var(--surface-3);
  font-size: var(--fs-caption);
}

/* ── ② 筛选行 ── */
.lib-filter-row,
.lib-sort-row {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-sm);
}
.lib-sort-row { justify-content: space-between; }

.lf-label {
  flex: none;
  width: 68rpx;
  font-size: var(--fs-caption);
  color: var(--text-weak);
}
.lf-scroll { flex: 1; width: 0; }
.lf-chips { display: flex; flex-direction: row; }

.lf-chip {
  flex: none;
  margin-right: var(--space-xs);
  padding: 10rpx 24rpx;
  font-size: var(--fs-caption);
  color: var(--text-sub);
  background: var(--surface-1);
  border: 1rpx solid var(--surface-3);
  border-radius: var(--radius-full);
}
.lf-chip.is-on {
  color: var(--gold);
  background: var(--gold-a10);
  border-color: var(--gold-a40);
  font-weight: 600;
}
.lf-chip.sort { padding: 8rpx 20rpx; font-size: var(--fs-mini); }

.lf-reset {
  flex: none;
  margin-left: var(--space-sm);
  padding: 10rpx 20rpx;
  font-size: var(--fs-caption);
  color: var(--text-sub);
  border: 1rpx solid var(--surface-3);
  border-radius: var(--radius-full);
}

/* ── ③ 结果统计 ── */
.lib-result {
  display: flex;
  align-items: baseline;
  margin: var(--space-md) 0 var(--space-sm);
}
.lr-count {
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--gold);
  margin-right: var(--space-xs);
}
.lr-total {
  font-size: var(--fs-mini);
  color: var(--text-weak);
}

/* ── ④ 作品卡片 ── */
.work-card {
  display: flex;
  align-items: center;
  background: var(--surface-1);
  border-radius: var(--radius-lg);
  padding: var(--space-sm);
  margin-bottom: var(--space-sm);
}
.wc-hover { background: var(--surface-2); }

.wc-poster {
  flex: none;
  width: 90rpx;
  height: 128rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--white);
}

.wc-info {
  flex: 1;
  min-width: 0;
  margin: 0 var(--space-sm);
}
.wc-name-row {
  display: flex;
  align-items: center;
}
.wc-name {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-main);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wc-star {
  flex: none;
  margin-left: var(--space-xs);
  font-size: var(--fs-caption);
  color: var(--gold);
}
.wc-en {
  font-size: var(--fs-mini);
  color: var(--text-weak);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wc-sub,
.wc-order {
  font-size: var(--fs-caption);
  color: var(--text-sub);
  margin-top: 2rpx;
}
.wc-order { color: var(--text-weak); font-size: var(--fs-mini); }

.wc-badge {
  flex: none;
  padding: 6rpx 16rpx;
  font-size: var(--fs-mini);
  border-radius: var(--radius-full);
}
.wc-badge.done {
  color: var(--success);
  background: var(--success-a15);
}
.wc-badge.todo {
  color: var(--text-weak);
  background: var(--surface-3);
}

/* ── 空状态 ── */
.lib-empty {
  margin-top: var(--space-2xl);
  text-align: center;
}
.le-title {
  font-size: var(--fs-body);
  color: var(--text-main);
  font-weight: 600;
}
.le-desc {
  margin-top: var(--space-xs);
  font-size: var(--fs-caption);
  color: var(--text-sub);
}
.le-btn {
  display: inline-block;
  margin-top: var(--space-lg);
  padding: 16rpx 48rpx;
  font-size: var(--fs-caption);
  color: var(--gold);
  background: var(--gold-a10);
  border: 1rpx solid var(--gold-a40);
  border-radius: var(--radius-full);
}

.btn-hover { opacity: 0.7; }
.mcu-bottom-space { height: var(--space-xl); }
