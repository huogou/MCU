<!-- 作品索引 library（Tab3）· V2.0.0 降级为「作品索引」
     定位：结构化索引 / 工具列表
     保留：名称搜索、状态筛选、结果统计
     删除：类型筛选、阶段筛选、多排序、简介、资料性描述
     合规：无资讯/新闻/热点/推荐文章；列表项仅展示作品基础信息 + 个人观看/收藏状态 -->
<view class="mcu-page lib-page">

  <!-- ═══ 搜索框 ═══ -->
  <view class="lib-search">
    <view class="ls-icon">⌕</view>
    <input class="ls-input"
           value="{{keyword}}"
           placeholder="搜索作品名称"
           placeholder-class="ls-ph"
           confirm-type="search"
           bindinput="onInput"
           bindconfirm="onInput" />
    <view wx:if="{{keyword}}" class="ls-clear" bindtap="onClearKeyword" hover-class="btn-hover" hover-stay-time="80">✕</view>
  </view>

  <!-- ═══ 状态筛选（V2.0 唯一筛选维度） ═══ -->
  <view class="lib-filter-row">
    <view class="lf-chips">
      <view wx:for="{{statusFilters}}" wx:key="key"
            class="lf-chip {{item.key === statusKey ? 'is-on' : ''}}"
            data-key="{{item.key}}" bindtap="onPickStatus"
            hover-class="btn-hover" hover-stay-time="60">{{item.label}}</view>
    </view>
    <view wx:if="{{isFiltering}}" class="lf-reset" bindtap="onReset" hover-class="btn-hover" hover-stay-time="80">重置</view>
  </view>

  <!-- ═══ 结果统计 ═══ -->
  <view class="lib-result">
    <text class="lr-count">共 {{resultCount}} 部</text>
    <text class="lr-total">/ 全库 {{totalCount}} 部 · 已看 {{watchedCount}} · 收藏 {{favCount}}</text>
  </view>

  <!-- ═══ 作品列表（仅白名单字段） ═══ -->
  <block wx:if="{{hasResult}}">
    <view class="work-card" wx:for="{{list}}" wx:key="id"
          data-id="{{item.id}}" bindtap="goDetail" hover-class="wc-hover" hover-stay-time="60">
      <view class="wc-poster {{item.poster ? '' : 'poster-p' + item.phase}}">
        <image wx:if="{{item.poster}}" class="fill-img" src="{{item.poster}}" mode="aspectFill" lazy-load="true" />
        <text wx:else>{{item.letter}}</text>
      </view>
      <view class="wc-info">
        <view class="wc-name-row">
          <text class="wc-name">{{item.cn}}</text>
          <text wx:if="{{item.favored}}" class="wc-star">★</text>
        </view>
        <view wx:if="{{item.en}}" class="wc-en">{{item.en}}</view>
        <view class="wc-sub">
          <text class="wc-type wc-type-{{item.typeKey}}">{{item.typeLabel}}</text>
          <text> · {{item.phaseText}}<text wx:if="{{item.year}}"> · {{item.year}}</text></text>
        </view>
        <view class="wc-order">{{item.order}}</view>
      </view>
      <view class="wc-badge {{item.watched ? 'done' : 'todo'}}">{{item.watched ? '已看' : '未看'}}</view>
    </view>
  </block>

  <!-- 空状态 -->
  <view wx:else class="lib-empty">
    <view class="le-title">没有匹配的作品</view>
    <view class="le-desc">换个关键词，或重置筛选条件后重试</view>
    <view class="le-btn" bindtap="onReset" hover-class="btn-hover" hover-stay-time="80">重置筛选</view>
  </view>

  <view class="mcu-bottom-space"></view>
</view>
