<!-- 我的MCU my-mcu（Tab3）
     结构：① 顶部个人进度区 ② 分享入口 ③ 成就墙 ④ 我的片单进度 ⑤ 最近观看
           ⑥ 我的作品清单（全部/已看/未看/收藏 · 可点击进详情 · 可就地收藏）
           ⑦ 反馈 ⑧ 法律与说明
     2026-09-08 整改第二阶段：原先「观看记录」「收藏」两段静态列表合并为 ⑥，
           列表项全部可点击进作品详情，收藏项提供就地取消收藏入口，消除死列表 -->
<view class="mcu-page">

  <!-- ① 顶部个人进度区 -->
  <view class="mcu-hero">
    <view class="mcu-hero-label">我的观影进度</view>
    <view class="mcu-explore">
      <text class="mcu-explore-num">{{explored}}</text>
      <text class="mcu-explore-sep">/</text>
      <text class="mcu-explore-total">{{total}}</text>
    </view>
    <view class="mcu-explore-tip">已看作品</view>
    <view class="mcu-progress">
      <view class="mcu-progress-bar" style="width:{{percent}}%;"></view>
    </view>
    <view class="mcu-progress-tip">整体进度 {{percent}}% · 未看 {{unwatchedCount}} 部 · 收藏 {{favCount}} 部</view>
  </view>

  <!-- ② 分享入口 -->
  <view class="entry-row">
    <view class="entry-card {{item.primary ? 'entry-primary' : ''}}" wx:for="{{entrances}}" wx:key="key" data-key="{{item.key}}" bindtap="goEntry" hover-class="entry-hover" hover-stay-time="80">
      <view class="entry-title">{{item.title}}</view>
      <view class="entry-desc">{{item.desc}}</view>
      <view class="entry-badge" wx:if="{{item.primary}}">生成海报</view>
    </view>
  </view>

  <!-- ③ 我的成就 -->
  <view class="section-label">我的成就 · {{achProgress.count}} / {{achProgress.total}}</view>
  <scroll-view class="ach-row" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="ach-item" wx:for="{{achievements}}" wx:key="id"
          data-id="{{item.id}}" data-gained="{{item.gained}}"
          bindtap="onTapAch" hover-class="ach-hover" hover-stay-time="80">
      <view class="ach-badge {{item.gained ? 'gained' : ''}}">{{item.icon}}</view>
      <view class="ach-name {{item.gained ? 'gained' : ''}}">{{item.name}}</view>
    </view>
  </scroll-view>

  <!-- ④ 我的片单进度（点击进入下一部未看作品详情） -->
  <view class="section-label">我的片单进度</view>
  <view class="route-next-card" wx:if="{{current}}" data-id="{{current.nextId}}" bindtap="goNext" hover-class="recent-hover" hover-stay-time="80">
    <view class="route-next-info">
      <view class="rn-label">继续观看 · {{current.phaseText}}</view>
      <view class="rn-title">{{current.name}}</view>
      <view class="rn-sub">{{current.watched}} / {{current.total}} 部 · 下一部 {{current.nextName}}</view>
      <view class="rn-progress">
        <view class="rn-progress-bar" style="width:{{current.percent}}%;"></view>
      </view>
    </view>
    <view class="route-next-btn {{current.nextId ? '' : 'is-disabled'}}">查看下一部</view>
  </view>

  <!-- ⑤ 最近观看 -->
  <view class="section-label">最近观看</view>
  <block wx:if="{{recentList.length}}">
    <scroll-view class="recent-row" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="recent-item" wx:for="{{recentList}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail" hover-class="recent-hover" hover-stay-time="80">
        <view class="recent-poster {{item.poster ? '' : 'poster-p' + item.phase}}">
          <image wx:if="{{item.poster}}" class="fill-img" src="{{item.poster}}" mode="aspectFill" />
          <text wx:else class="recent-letter">{{item.letter}}</text>
          <view class="recent-badge">已看</view>
        </view>
        <view class="recent-name">{{item.cn}}</view>
      </view>
    </scroll-view>
  </block>
  <view wx:else class="empty-tip">还没有观看记录，去「作品」页挑一部开始吧</view>

  <!-- ⑥ 我的作品清单：统计卡 + 列表 -->
  <view class="section-label">我的作品清单</view>
  <view class="stat-row">
    <view class="stat-card {{listKey === 'watched' ? 'is-on' : ''}}" data-key="watched" bindtap="onPickTab" hover-class="recent-hover" hover-stay-time="80">
      <view class="stat-num">{{explored}}</view>
      <view class="stat-label">已看</view>
    </view>
    <view class="stat-card {{listKey === 'unwatched' ? 'is-on' : ''}}" data-key="unwatched" bindtap="onPickTab" hover-class="recent-hover" hover-stay-time="80">
      <view class="stat-num">{{unwatchedCount}}</view>
      <view class="stat-label">未看</view>
    </view>
    <view class="stat-card {{listKey === 'fav' ? 'is-on' : ''}}" data-key="fav" bindtap="onPickTab" hover-class="recent-hover" hover-stay-time="80">
      <view class="stat-num">{{favCount}}</view>
      <view class="stat-label">收藏</view>
    </view>
    <view class="stat-card {{listKey === 'all' ? 'is-on' : ''}}" data-key="all" bindtap="onPickTab" hover-class="recent-hover" hover-stay-time="80">
      <view class="stat-num">{{total}}</view>
      <view class="stat-label">全部</view>
    </view>
  </view>

  <view class="tab-row">
    <view wx:for="{{tabs}}" wx:key="key"
          class="tab-chip {{item.key === listKey ? 'is-on' : ''}}"
          data-key="{{item.key}}" bindtap="onPickTab" hover-class="recent-hover" hover-stay-time="60">{{item.label}}</view>
  </view>

  <view class="card-list">
    <block wx:if="{{list.length}}">
      <view class="work-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail" hover-class="wc-hover" hover-stay-time="60">
        <view class="wc-poster {{item.poster ? '' : 'poster-p' + item.phase}}">
          <image wx:if="{{item.poster}}" class="fill-img" src="{{item.poster}}" mode="aspectFill" />
          <text wx:else>{{item.letter}}</text>
        </view>
        <view class="wc-info">
          <view class="wc-name">{{item.cn}}</view>
          <view class="wc-sub">{{item.typeLabel}} · {{item.phaseText}}</view>
          <view class="wc-order">{{item.order}}</view>
        </view>
        <!-- 内联收藏开关：catchtap 阻断冒泡，不与整行跳转冲突 -->
        <view class="wc-fav {{item.favored ? 'is-on' : ''}}"
              data-id="{{item.id}}" catchtap="onToggleFavItem" hover-class="btn-hover" hover-stay-time="80">{{item.favored ? '★' : '☆'}}</view>
        <view class="wc-badge {{item.watched ? 'done' : 'todo'}}">{{item.watched ? '已看' : '未看'}}</view>
      </view>
    </block>
    <view wx:else class="empty-tip">{{listEmptyText}}</view>
  </view>

  <!-- ⑦ 反馈入口 -->
  <view class="section-label">反馈与帮助</view>
  <view class="fb-entry" bindtap="goFeedback">
    <view class="fb-entry-info">
      <view class="fb-entry-title">我要吐槽</view>
      <view class="fb-entry-sub">发现问题？顺手反馈，帮我们把导航做更准</view>
    </view>
    <view class="fb-entry-arrow">›</view>
  </view>

  <!-- ⑧ 法律与说明 -->
  <view class="section-label">法律与说明</view>
  <view class="legal-list">
    <view class="fb-entry" data-key="agreement" bindtap="goLegal">
      <view class="fb-entry-info">
        <view class="fb-entry-title">用户协议</view>
        <view class="fb-entry-sub">服务说明与使用规则</view>
      </view>
      <view class="fb-entry-arrow">›</view>
    </view>
    <view class="fb-entry" data-key="privacy" bindtap="goLegal">
      <view class="fb-entry-info">
        <view class="fb-entry-title">隐私保护政策</view>
        <view class="fb-entry-sub">数据收集与权限说明</view>
      </view>
      <view class="fb-entry-arrow">›</view>
    </view>
    <view class="fb-entry" data-key="about" bindtap="goLegal">
      <view class="fb-entry-info">
        <view class="fb-entry-title">关于</view>
        <view class="fb-entry-sub">产品介绍与版本</view>
      </view>
      <view class="fb-entry-arrow">›</view>
    </view>
  </view>

  <view class="mcu-bottom-space"></view>
</view>
